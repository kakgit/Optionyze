<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <%- include('partials/brand-head') %>
    <link rel="stylesheet" href="/css/app-shell.css" />
    <link rel="stylesheet" href="/css/account-menu.css" />
    <link rel="stylesheet" href="/css/rolling-options-pt-de.css" />
    <link rel="stylesheet" href="/css/rolling-futures-lt-common.css" />
    <link rel="stylesheet" href="/css/rolling-futures-lt-dual.css" />
</head>
  <%
    const vPageVariantRaw = String(pageVariant || "live").trim().toLowerCase();
    const vPageVariant = vPageVariantRaw === "demo"
        ? "demo"
        : (vPageVariantRaw === "strangle"
            ? "strangle"
            : (vPageVariantRaw === "strangle-demo"
                ? "strangle-demo"
                : (vPageVariantRaw === "renko" ? "renko" : "live")));
    const bIsDemoPage = vPageVariant === "demo";
    const bIsStranglePage = vPageVariant === "strangle";
    const bIsStrangleDemoPage = vPageVariant === "strangle-demo";
    const bIsRenkoPage = vPageVariant === "renko";
    const bIsPaperDemoPage = bIsDemoPage || bIsStrangleDemoPage;
    const bIsCoveredLivePage = !bIsDemoPage && !bIsStranglePage && !bIsStrangleDemoPage && !bIsRenkoPage;
    const bShowRenkoSection = bIsDemoPage || bIsRenkoPage || bIsCoveredLivePage;
    const bIsStrangleLikePage = bIsStranglePage || bIsStrangleDemoPage || bIsRenkoPage;
    const bShowLiveSupportSections = !bIsDemoPage && !bIsStrangleDemoPage && !bIsCoveredLivePage;
    const bShowConfirmationSection = !bIsDemoPage && !bIsStrangleDemoPage && (bShowLiveSupportSections || bIsCoveredLivePage);
    const bShowTelegramAlertsSection = false;
    const bShowImportPositionsUi = !bIsPaperDemoPage;
    const vStrategyLabel = "Futures Scalper";
    const vPageHeading = "Futures Scalper";
    const vEndpointBase = "/api/futures-scalper";
    const vOpenPositionsEmpty = bIsPaperDemoPage
        ? "No demo positions are currently shown."
        : `Select an API profile and load live ${bIsRenkoPage ? "options-scalper" : ((bIsStranglePage || bIsStrangleDemoPage) ? "strangle-option" : "covered-option")} positions from Delta Exchange.`;
    const vClosedPositionsEmpty = bIsPaperDemoPage
        ? "No demo trade history found for the selected date range."
        : "No Delta fill history found for the selected date range.";
    const vConfirmationHeading = "Confirmation";
    const vConfirmationAutoText = `Auto-confirm all ${bIsRenkoPage ? "options-scalper" : ((bIsStranglePage || bIsStrangleDemoPage) ? "strangle" : "covered")} live actions`;
    const vConfirmationEmpty = "No live action is waiting for confirmation.";
    const vActivityEmpty = bIsPaperDemoPage ? "No demo activity has been logged yet." : "No live activity has been logged yet.";
    const vClearOpenPositionsTitle = bIsPaperDemoPage ? "Clear all demo open positions locally" : "Clear all imported open positions locally";
    const vRefreshOpenPositionsTitle = bIsPaperDemoPage ? "Refresh demo positions" : "Refresh open positions";
    const vKillSwitchTitle = bIsPaperDemoPage ? "Kill switch to close demo option legs" : "Kill switch to close live option legs";
    const vClearClosedPositionsTitle = bIsPaperDemoPage ? "Clear all demo closed positions locally" : "";
    const vRefreshClosedTitle = bIsPaperDemoPage ? "Refresh closed demo positions" : "Refresh closed positions from Delta Exchange";
  %>
  <body class="app-page"
        data-rolling-futures-live="covered"
        data-rolling-futures-variant="<%= vPageVariant %>"
        data-rolling-futures-endpoint-base="<%= vEndpointBase %>"
        data-rolling-futures-strategy-label="<%= vStrategyLabel %>"
        data-manual-trader-label="Futures Controls"
        data-futures-scalper="true"
        data-exec-strategy-enabled="<%= currentAccount?.execStrategy ? 'true' : 'false' %>"
        data-current-account-id="<%= currentAccount?.accountId || '' %>"
        data-current-account-admin="<%= currentAccount?.isAdmin ? 'true' : 'false' %>"
        data-current-account-verifier="<%= currentAccount?.isVerifier ? 'true' : 'false' %>"
        data-current-account-full-name="<%= currentAccount?.fullName || '' %>"
        data-current-account-email="<%= currentAccount?.email || '' %>"
        data-current-account-telegram-chat-id="<%= currentAccount?.telegramChatId || '' %>">
    <div class="app-layout rolling-demo-layout">
        <%- include('partials/app-header', { currentAccount }) %>

        <section class="rolling-demo-hero">
            <div class="app-panel rolling-demo-card">
                <h1 class="rolling-demo-title"><%= vPageHeading %></h1>
                <div class="rolling-futures-hero-badges">
                    <div class="rolling-futures-hero-badge">
                        <label for="ddlRollingFuturesSymbol">Symbols List</label>
                        <select id="ddlRollingFuturesSymbol">
                            <option value="">Select Symbol</option>
                            <option value="BTC" selected>BTCUSD</option>
                            <option value="ETH">ETHUSD</option>
                        </select>
                    </div>
                    <div class="rolling-futures-hero-badge">
                        <div class="rolling-futures-start-qty-label-row">
                            <label for="txtRollingFuturesStartQty">Multiplier</label>
                            <% if (!bIsCoveredLivePage) { %>
                                <button class="rolling-futures-start-qty-calc-btn" type="button" id="btnRollingFuturesCalcStartQty" title="Calculate Multiplier from Available Balance" aria-label="Calculate Multiplier from Available Balance">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <rect x="4" y="3" width="16" height="18" rx="2" />
                                        <path d="M8 7h8" />
                                        <path d="M8 12h2" />
                                        <path d="M14 12h2" />
                                        <path d="M8 16h2" />
                                        <path d="M14 16h2" />
                                    </svg>
                                </button>
                            <% } %>
                        </div>
                        <div class="rolling-futures-start-qty-row">
                            <input class="rolling-futures-start-qty" type="number" min="<%= (bIsDemoPage || bIsStrangleLikePage || bIsCoveredLivePage) ? '1' : '2' %>" max="1000" step="1" id="txtRollingFuturesStartQty" value="<%= (bIsDemoPage || bIsStrangleLikePage || bIsCoveredLivePage) ? '1' : '2' %>" />
                        </div>
                    </div>
                    <div class="rolling-futures-hero-badge action">
                        <button class="rolling-demo-btn warn" type="button" id="btnRollingFuturesDemoAutoTrader">Auto Trader - OFF</button>
                    </div>
                </div>
                <% if (!bIsStrangleDemoPage) { %>
                <div class="rolling-futures-help-sample-inline rolling-futures-hero-rules">
                    <div class="rolling-futures-help-inline-row">
                        <div class="rolling-futures-help-inline-main">
                            <div class="rolling-futures-help-inline-top">
                                <label class="rolling-futures-neutral-mode rolling-futures-help-mode" for="chkRollingFuturesCloseNetProfitBrokerage">
                                    <input type="checkbox" id="chkRollingFuturesCloseNetProfitBrokerage" checked />
                                    <span>Exit All if Net PnL is &gt; X of Brokerage</span>
                                    <span class="rolling-futures-help-icon-wrap">
                                        <button type="button" class="rolling-futures-help-trigger" aria-label="Show brokerage help">
                                            ?
                                        </button>
                                        <span class="rolling-futures-help-popout floating">
                                            Monitors <code>Net PnL</code> against <code>Total Brokerage to Recvr x multiplier</code>. When the rule stays valid long enough, it can close all positions.
                                        </span>
                                    </span>
                                </label>
                            </div>
                            <div class="rolling-futures-help-inline-bottom">
                                <div class="rolling-demo-field rolling-futures-help-input-field">
                                    <input type="number" id="txtRollingFuturesBrokerageMultiplier" value="<%= bIsCoveredLivePage ? '7' : (bIsStrangleLikePage ? '5' : '10') %>" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <% const vShowPosPnlCloseRule = bIsCoveredLivePage || bIsDemoPage; %>
                    <div class="rolling-futures-help-inline-row">
                        <div class="rolling-futures-help-inline-main">
                            <div class="rolling-futures-help-inline-top">
                                <label class="rolling-futures-neutral-mode rolling-futures-help-mode" for="<%= vShowPosPnlCloseRule ? 'chkRollingFuturesClosePosPnlAboveBrokerage' : 'chkRollingFuturesCloseBlockedMargin' %>">
                                    <% if (vShowPosPnlCloseRule) { %>
                                    <input type="checkbox" id="chkRollingFuturesClosePosPnlAboveBrokerage" />
                                    <span>Close if Pos PnL &gt; X of Pos Brokerage</span>
                                    <span class="rolling-futures-help-icon-wrap">
                                        <button type="button" class="rolling-futures-help-trigger" aria-label="Show position stop help">
                                            ?
                                        </button>
                                        <span class="rolling-futures-help-popout floating">
                                            Monitors every open position individually: closes ONLY that position when its live PnL exceeds X &times; its own brokerage. All other positions keep running until the overall target PnL is achieved.
                                        </span>
                                    </span>
                                    <% } else { %>
                                    <input type="checkbox" id="chkRollingFuturesCloseBlockedMargin" <%= bIsCoveredLivePage ? '' : 'checked' %> />
                                    <span>Exit All if Net PnL is X% of Blocked Margin</span>
                                    <span class="rolling-futures-help-icon-wrap">
                                        <button type="button" class="rolling-futures-help-trigger" aria-label="Show blocked margin help">
                                            ?
                                        </button>
                                        <span class="rolling-futures-help-popout floating">
                                            Monitors <code>Net PnL</code> against the configured percentage of current blocked margin before allowing a close-all.
                                        </span>
                                    </span>
                                    <% } %>
                                </label>
                            </div>
                            <div class="rolling-futures-help-inline-bottom">
                                <div class="rolling-demo-field rolling-futures-help-input-field">
                                    <input type="number" id="<%= vShowPosPnlCloseRule ? 'txtRollingFuturesClosePosPnlAboveBrokerageX' : 'txtRollingFuturesBlockedMarginPct' %>" value="<%= vShowPosPnlCloseRule ? '5' : (bIsStrangleLikePage ? '10' : '20') %>" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>
                <div class="rolling-futures-hero-metrics rolling-futures-help-sample-inline">
                    <div class="rolling-futures-hero-metric">
                        <label for="txtRollingFuturesBrok2Rec">Total Brokerage</label>
                        <input class="rolling-demo-metric-input" type="number" id="txtRollingFuturesBrok2Rec" value="0" />
                    </div>
                    <div class="rolling-futures-hero-metric">
                        <label for="txtRollingFuturesYet2Recover">Total PnL</label>
                        <input class="rolling-demo-metric-input" type="number" id="txtRollingFuturesYet2Recover" value="0" />
                    </div>
                    <div class="rolling-futures-hero-metric">
                        <label for="divRollingFuturesNetPl">Net PnL</label>
                        <div class="rolling-demo-metric-value rolling-futures-hero-metric-value" id="divRollingFuturesNetPl">0.00</div>
                    </div>
                </div>
            </div>
            <div class="app-panel rolling-demo-card">
                <div class="rolling-demo-card-head">
                    <h2>Exchange Connection</h2>
                    <div class="rolling-demo-card-tools">
                        <% if (currentAccount?.isVerifier) { %>
                            <div class="rolling-live-admin-target-head">
                                <div class="rolling-demo-field rolling-live-admin-target-field">
                                    <select id="ddlRollingDualAdminTargetUser">
                                        <option value="">Loading running users...</option>
                                    </select>
                                </div>
                                <div class="rolling-live-admin-target-meta" id="rollingDualAdminTargetMeta">Select a running <%= vStrategyLabel %> user to load settings and positions.</div>
                            </div>
                        <% } %>
                        <button class="rolling-demo-icon-btn primary" type="button" id="btnRollingDualFuturesCheckConnection" title="Check Delta connection" aria-label="Check Delta connection">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                                <path d="M21 3v6h-6" />
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="rolling-live-connection-grid">
                    <div class="rolling-demo-field">
                        <label for="ddlRollingDualFuturesApiProfile">API Name</label>
                        <select id="ddlRollingDualFuturesApiProfile">
                            <option value="">Select API profile</option>
                        </select>
                    </div>
                    <div class="rolling-demo-metric">
                        <div class="rolling-demo-metric-label">Connection Status</div>
                        <div class="rolling-demo-metric-value" id="rollingDualFuturesConnectionStateValue">Not Selected</div>
                    </div>
                    <div class="rolling-demo-metric">
                        <div class="rolling-demo-metric-label rolling-live-ip-label">
                            <span>Whitelist IP</span>
                            <button class="rolling-live-copy-ip-btn" type="button" id="btnRollingDualFuturesCopyWhitelistIp" title="Copy this server IP for Delta Exchange whitelist" aria-label="Copy this server IP for Delta Exchange whitelist">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M9 9h10v12H9z" />
                                    <path d="M5 15V5h10" />
                                </svg>
                            </button>
                        </div>
                        <div class="rolling-live-ip-row">
                            <div class="rolling-demo-metric-value" id="rollingDualFuturesWhitelistIpValue">-</div>
                        </div>
                    </div>
                </div>
                <div class="rolling-demo-summary rolling-live-summary">
                    <div class="app-stat rolling-demo-stat">
                        <div class="rolling-demo-stat-label">Engine Status</div>
                        <div class="rolling-demo-stat-value" id="rollingDualFuturesEngineStatus">Idle</div>
                    </div>
                    <div class="app-stat rolling-demo-stat">
                        <div class="rolling-demo-stat-label">Last Checked</div>
                        <div class="rolling-demo-stat-value" id="rollingDualFuturesLastCheckedValue">-</div>
                    </div>
                    <div class="app-stat rolling-demo-stat">
                        <div class="rolling-demo-stat-label">Open Positions</div>
                        <div class="rolling-demo-stat-value" id="rollingDualFuturesOpenCount">0</div>
                    </div>
                </div>
                <div class="rolling-demo-grid metrics rolling-demo-section rolling-live-balance-metrics">
                    <div class="rolling-demo-metric">
                        <div class="rolling-demo-metric-label">Total Balance</div>
                        <div class="rolling-demo-metric-value" id="rollingDualFuturesTotalBalanceValue">-</div>
                    </div>
                    <div class="rolling-demo-metric">
                        <div class="rolling-demo-metric-label">Blocked Margin</div>
                        <div class="rolling-demo-metric-value" id="rollingDualFuturesBlockedMarginValue">-</div>
                    </div>
                    <div class="rolling-demo-metric">
                        <div class="rolling-demo-metric-label">Available Balance</div>
                        <div class="rolling-demo-metric-value" id="rollingDualFuturesAvailableBalanceValue">-</div>
                    </div>
                </div>
                <div class="rolling-live-status" id="rollingDualFuturesConnectionStatus"></div>
                <div class="rolling-live-status" id="rollingDualFuturesPageStatus"></div>
            </div>
        </section>

        <section class="rolling-demo-section rolling-futures-card-stack">
            <div class="app-panel rolling-demo-card">
                <div class="rolling-demo-card-head">
                    <div class="rolling-futures-inline-tools">
                        <span class="rolling-demo-manual-title">Futures Controls</span>
                    </div>
                    <div class="rolling-demo-card-tools rolling-futures-manual-tools">
                        <button class="rolling-demo-icon-btn primary" type="button" id="btnRollingFuturesShowSavedProfile" title="Show saved Futures Controls values from DB" aria-label="Show saved Futures Controls values from DB">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <ellipse cx="12" cy="6" rx="7" ry="3" />
                                <path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6" />
                                <path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6" />
                            </svg>
                        </button>
                        <button class="rolling-demo-icon-btn primary" type="button" id="btnRollingFuturesResetDefaults" title="Reset Futures Controls defaults" aria-label="Reset Futures Controls defaults">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M3 12a9 9 0 1 0 3-6.7" />
                                <path d="M3 3v6h6" />
                            </svg>
                        </button>
                        <button class="rolling-demo-btn primary rolling-futures-exec-strategy-btn" type="button" id="btnRollingFuturesExecAllLegs" title="Open paper trades using the Futures Controls settings" aria-label="Open paper trades using the Futures Controls settings">
                            Exec Strategy
                        </button>
                    </div>
                </div>
                <div class="rolling-futures-hidden" style="display:none;" aria-hidden="true">
                    <select id="ddlRollingFuturesAction1" style="display:none;">
                        <option value="none">None</option>
                        <option value="buy">Buy</option>
                        <option value="sell" selected>Sell</option>
                    </select>
                    <select id="ddlRollingFuturesLegs1" style="display:none;">
                        <option value="both" selected>Both</option>
                        <option value="ce">CE</option>
                        <option value="pe">PE</option>
                    </select>
                    <select id="ddlRollingFuturesExpiryType1" style="display:none;">
                        <option value="1">DAILY T+1</option>
                        <option value="2">DAILY T+2</option>
                        <option value="4">WEEKLY</option>
                        <option value="5">BI-WEEKLY</option>
                        <option value="6" selected>MONTHLY</option>
                        <option value="7">BI-MONTHLY</option>
                    </select>
                    <input type="date" id="txtRollingFuturesExpiry1" style="display:none;" />
                    <input type="number" min="1" id="txtRollingFuturesQty1" value="1" style="display:none;" />
                    <input type="number" min="0" max="2" step="0.01" id="txtRollingFuturesNewD1" value="0.33" style="display:none;" />
                    <input type="number" min="0" max="2" step="0.01" id="txtRollingFuturesTpD1" value="0.10" style="display:none;" />
                    <input type="number" min="0" max="2" step="0.01" id="txtRollingFuturesSlD1" value="0.50" style="display:none;" />
                    <input type="checkbox" id="chkRollingFuturesReEnter1" checked style="display:none;" />
                    <select id="ddlRollingFuturesAction2" style="display:none;">
                        <option value="none">None</option>
                        <option value="buy" selected>Buy</option>
                        <option value="sell">Sell</option>
                    </select>
                    <select id="ddlRollingFuturesLegs2" style="display:none;">
                        <option value="both" selected>Both</option>
                        <option value="ce">CE</option>
                        <option value="pe">PE</option>
                    </select>
                    <select id="ddlRollingFuturesExpiryType2" style="display:none;">
                        <option value="1" selected>DAILY T+1</option>
                        <option value="2">DAILY T+2</option>
                        <option value="4">WEEKLY</option>
                        <option value="5">BI-WEEKLY</option>
                        <option value="6">MONTHLY</option>
                        <option value="7">BI-MONTHLY</option>
                    </select>
                    <input type="date" id="txtRollingFuturesExpiry2" style="display:none;" />
                    <input type="number" min="1" id="txtRollingFuturesQty2" value="1" style="display:none;" />
                    <input type="number" min="0" max="2" step="0.01" id="txtRollingFuturesNewD2" value="0.13" style="display:none;" />
                    <input type="number" min="0" max="2" step="0.01" id="txtRollingFuturesTpD2" value="1.00" style="display:none;" />
                    <input type="number" min="0" max="2" step="0.01" id="txtRollingFuturesSlD2" value="0.05" style="display:none;" />
                    <input type="checkbox" id="chkRollingFuturesReEnter2" checked style="display:none;" />
                </div>
                <div class="rolling-futures-demo-grid row futures-scalper-controls-grid">
                    <div class="rolling-demo-field">
                        <label for="ddlRollingFuturesTradeSide">Trade Side</label>
                        <select id="ddlRollingFuturesTradeSide">
                            <option value="both" selected>Both (Buy + Sell)</option>
                            <option value="sell_only">Sell Only</option>
                            <option value="buy_only">Buy Only</option>
                        </select>
                    </div>
                    <div class="rolling-demo-field">
                        <label for="ddlRollingFuturesOrderType">Order Type</label>
                        <select id="ddlRollingFuturesOrderType">
                            <option value="market_order" selected>Market</option>
                            <option value="limit_order">Limit</option>
                        </select>
                    </div>
                    <div class="rolling-demo-field">
                        <label for="txtRollingFuturesFutLimitPrice">Limit Price</label>
                        <input type="number" min="0" step="0.01" id="txtRollingFuturesFutLimitPrice" placeholder="Used for Limit orders" />
                    </div>
                    <div class="rolling-demo-field">
                        <label for="txtRollingFuturesBsQty">Qty (Lots)</label>
                        <input type="number" min="1" step="1" id="txtRollingFuturesBsQty" value="1" />
                    </div>
                    <div class="rolling-demo-field">
                        <button class="rolling-demo-btn buy" type="button" id="btnRollingFuturesBuyFuture">BUY FUT</button>
                    </div>
                    <div class="rolling-demo-field">
                        <button class="rolling-demo-btn sell" type="button" id="btnRollingFuturesSellFuture">SELL FUT</button>
                    </div>
                </div>
                <div class="rolling-futures-demo-grid row futures-scalper-controls-grid futures-scalper-ladder-grid">
                    <div class="rolling-demo-field">
                        <label for="txtRollingFuturesLadderStepPoints">Ladder Step (Pts)</label>
                        <input type="number" min="1" step="1" id="txtRollingFuturesLadderStepPoints" value="200" title="Trigger levels are spaced this many points apart" />
                    </div>
                    <div class="rolling-demo-field">
                        <label for="txtRollingFuturesLadderGridOffsetPoints">Grid Offset (Pts)</label>
                        <input type="number" min="0" step="1" id="txtRollingFuturesLadderGridOffsetPoints" value="50" title="Ladder levels land on ...N+offset, e.g. 78850 when offset is 50" />
                    </div>
                    <div class="rolling-demo-field">
                        <label for="txtRollingFuturesLadderOrderOffsetPoints">Order Offset (Pts)</label>
                        <input type="number" min="0" step="1" id="txtRollingFuturesLadderOrderOffsetPoints" value="100" title="Sell order is armed this many points below the trigger level" />
                    </div>
                    <div class="rolling-demo-field">
                        <label for="txtRollingFuturesLadderCancelOffsetPoints">Cancel Offset (Pts)</label>
                        <input type="number" min="1" step="1" id="txtRollingFuturesLadderCancelOffsetPoints" value="50" title="Armed order is cancelled if a green box reaches trigger + this" />
                    </div>
                    <div class="rolling-demo-field">
                        <label for="txtRollingFuturesLadderStopLossPoints">Stop Loss (Pts)</label>
                        <input type="number" min="0" step="1" id="txtRollingFuturesLadderStopLossPoints" value="100" title="Stop loss is placed this many points above the entry" />
                    </div>
                    <div class="rolling-demo-field">
                        <label for="txtRollingFuturesLadderTakeProfitPoints">Take Profit (Pts)</label>
                        <input type="number" min="0" step="1" id="txtRollingFuturesLadderTakeProfitPoints" value="150" title="Take profit is placed this many points below the entry" />
                    </div>
                </div>
                <div class="rolling-futures-demo-grid row futures-scalper-controls-grid futures-scalper-ladder-grid">
                    <div class="rolling-demo-field">
                        <label for="chkRollingFuturesLadderTrailingEnabled">Trailing SL</label>
                        <div class="rolling-renko-feed-value-row">
                            <label class="rolling-renko-feed-switch" for="chkRollingFuturesLadderTrailingEnabled">
                                <input type="checkbox" id="chkRollingFuturesLadderTrailingEnabled" />
                                <span class="rolling-renko-feed-switch-track" aria-hidden="true"></span>
                                <span class="rolling-renko-feed-switch-text">Trail</span>
                            </label>
                        </div>
                    </div>
                    <div class="rolling-demo-field">
                        <label for="txtRollingFuturesLadderTrailingStopPoints">Trail Distance (Pts)</label>
                        <input type="number" min="1" step="1" id="txtRollingFuturesLadderTrailingStopPoints" value="50" title="Once trailing is active the stop is kept this many points behind the live price" />
                    </div>
                    <div class="rolling-demo-field">
                        <label for="txtRollingFuturesLadderTrailingActivatePoints">Activate After (Pts)</label>
                        <input type="number" min="0" step="1" id="txtRollingFuturesLadderTrailingActivatePoints" value="50" title="Trailing starts only once the trade is in profit by at least this many points" />
                    </div>
                </div>
