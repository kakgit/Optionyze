                                <th>P &amp; L</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="rollingDualFuturesClosedAltClosedPositionsBody">
                            <tr>
                                <td colspan="10" class="rolling-demo-empty"><%= vClosedPositionsEmpty %></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="rolling-demo-card-tools rolling-live-pagination">
                    <div class="rolling-live-open-signal" id="rollingDualFuturesClosedAltClosedPositionsPageInfo">Page 0 of 0</div>
                    <button class="rolling-demo-icon-btn warn" type="button" id="btnRollingDualFuturesClosedAltPrevPage" title="Previous closed-positions page" aria-label="Previous closed-positions page">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m15 18-6-6 6-6" />
                        </svg>
                    </button>
                    <div class="rolling-live-page-numbers" id="rollingDualFuturesClosedAltClosedPageNumbers"></div>
                    <button class="rolling-demo-icon-btn primary" type="button" id="btnRollingDualFuturesClosedAltNextPage" title="Next closed-positions page" aria-label="Next closed-positions page">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m9 6 6 6-6 6" />
                        </svg>
                    </button>
                </div>
            </div>

            <% if (!bIsPaperDemoPage && !bIsCoveredLivePage) { %>
            <div class="app-panel rolling-demo-card rolling-futures-hidden rolling-futures-indicator-card" id="cardRollingFuturesDeltaDirec">
                <div class="rolling-demo-card-head rolling-futures-indicator-head-row">
                    <h2>Delta Direction</h2>
                </div>
                <div class="rolling-demo-table-wrap">
                    <table class="rolling-demo-table">
                        <thead>
                            <tr>
                                <th>Dated</th>
                                <th>Daily Call</th>
                                <th>Daily Put</th>
                                <th>Direc</th>
                                <th>Weekly Call</th>
                                <th>Weekly Put</th>
                                <th>Direc</th>
                                <th>Monthly Call</th>
                                <th>Monthly Put</th>
                                <th>Direc</th>
                                <th>OA Direc</th>
                            </tr>
                        </thead>
                        <tbody id="tBodyRollingFuturesDeltas">
                            <tr class="rolling-futures-empty-body">
                                <td colspan="11">No delta direction data yet.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <% } %>

            <div class="rolling-demo-log-grid">
                <% if (bShowRenkoSection) { %>
                    <div class="app-panel rolling-demo-card rolling-renko-feed-card">
                        <div class="rolling-demo-card-head">
                            <div class="rolling-futures-indicator-head-row">
                                <h2><%= (bIsDemoPage || bIsCoveredLivePage) ? "Delta Renko-Style Feed" : "Renko Feed" %></h2>
                                <div class="rolling-renko-feed-header-badges">
                                    <span class="rolling-renko-feed-status-badge off" id="rollingRenkoFeedStatus">OFF</span>
                                    <span class="rolling-renko-feed-color-badge neutral" id="rollingRenkoCurrentBoxColor">-</span>
                                </div>
                            </div>
                            <div class="rolling-demo-card-tools">
                                <button class="rolling-demo-icon-btn primary" type="button" id="btnRollingRenkoRefresh" title="<%= (bIsDemoPage || bIsCoveredLivePage) ? "Refresh Delta Renko feed" : "Refresh Renko feed" %>" aria-label="<%= (bIsDemoPage || bIsCoveredLivePage) ? "Refresh Delta Renko feed" : "Refresh Renko feed" %>">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                                        <path d="M21 3v6h-6" />
                                    </svg>
                                </button>
                                <button class="rolling-demo-icon-btn warn" type="button" id="btnRollingRenkoClear" title="<%= (bIsDemoPage || bIsCoveredLivePage) ? "Clear Delta Renko feed" : "Clear Renko feed" %>" aria-label="<%= (bIsDemoPage || bIsCoveredLivePage) ? "Clear Delta Renko feed" : "Clear Renko feed" %>">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M18 6 6 18" />
                                        <path d="m6 6 12 12" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                        <div class="rolling-renko-feed-stack">
                            <% if (bIsDemoPage || bIsCoveredLivePage) { %>
                            <div class="rolling-renko-feed-grid rolling-renko-feed-grid-demo">
                                <div class="rolling-demo-field rolling-renko-feed-field">
                                    <label for="chkRollingFuturesRenkoFeedEnabled">Delta Renko Feed</label>
                                    <div class="rolling-renko-feed-value-row">
                                        <label class="rolling-renko-feed-switch" for="chkRollingFuturesRenkoFeedEnabled">
                                            <input type="checkbox" id="chkRollingFuturesRenkoFeedEnabled" <%= bIsCoveredLivePage ? 'checked' : '' %> />
                                            <span class="rolling-renko-feed-switch-track" aria-hidden="true"></span>
                                            <span class="rolling-renko-feed-switch-text">Feed</span>
                                        </label>
                                    </div>
                                </div>
                                <div class="rolling-demo-field rolling-renko-feed-field">
                                    <label for="txtRollingFuturesRenkoFeedPts">Point Size</label>
                                    <input type="number" id="txtRollingFuturesRenkoFeedPts" min="1" step="1" value="<%= bIsCoveredLivePage ? '50' : '10' %>" />
                                </div>
                                <div class="rolling-demo-field rolling-renko-feed-field">
                                    <label>From</label>
                                    <div class="rolling-renko-feed-value-row">
                                        <span class="rolling-renko-feed-value-badge" id="rollingRenkoFromPrice">--</span>
                                    </div>
                                </div>
                                <div class="rolling-demo-field rolling-renko-feed-field">
                                    <label>Anchor</label>
                                    <div class="rolling-renko-feed-value-row">
                                        <span class="rolling-renko-feed-value-badge" id="rollingRenkoAnchorPrice">--</span>
                                    </div>
                                </div>
                            </div>
                            <div class="rolling-renko-feed-grid rolling-renko-feed-grid-demo-bottom">
                                <div class="rolling-demo-field rolling-renko-feed-field">
                                    <label for="ddlRollingFuturesRenkoFeedTimeframe">Timeframe</label>
                                    <select id="ddlRollingFuturesRenkoFeedTimeframe">
                                        <option value="5s" <%= bIsCoveredLivePage ? 'selected' : '' %>>5s</option>
                                        <option value="1m">1m</option>
                                        <option value="3m">3m</option>
                                        <option value="5m" <%= bIsCoveredLivePage ? '' : 'selected' %>>5m</option>
                                        <option value="15m">15m</option>
                                        <option value="30m">30m</option>
                                        <option value="1h">1h</option>
                                    </select>
                                </div>
                                <div class="rolling-demo-field rolling-renko-feed-field">
                                    <label for="ddlRollingFuturesRenkoFeedPriceSrc">Price Source</label>
                                    <select id="ddlRollingFuturesRenkoFeedPriceSrc">
                                        <option value="spot_price" <%= bIsCoveredLivePage ? '' : 'selected' %>>Spot Price</option>
                                        <option value="mark_price" <%= bIsCoveredLivePage ? 'selected' : '' %>>Mark Price</option>
                                        <option value="best_bid">Best Bid</option>
                                        <option value="best_ask">Best Ask</option>
                                    </select>
                                </div>
                                <div class="rolling-demo-field rolling-renko-feed-field">
                                    <label for="txtRollingFuturesRenkoFeedManualPrice">Manual Anchor</label>
                                    <input type="number" id="txtRollingFuturesRenkoFeedManualPrice" min="0" step="0.01" placeholder="Optional" />
                                </div>
                                <div class="rolling-demo-field rolling-renko-feed-field">
                                    <label>&nbsp;</label>
                                    <div class="rolling-renko-feed-action-row">
                                        <button class="rolling-demo-btn warn" type="button" id="btnRollingRenkoManualRed">R</button>
                                        <button class="rolling-demo-btn primary" type="button" id="btnRollingRenkoManualGreen">G</button>
                                    </div>
                                </div>
                                <div class="rolling-demo-field rolling-renko-feed-field">
                                    <label>&nbsp;</label>
                                    <button class="rolling-demo-btn success" type="button" id="btnRollingRenkoUpdate">Update</button>
                                </div>
                            </div>
                            <% } else { %>
                            <div class="rolling-renko-feed-grid">
                                <div class="rolling-demo-field rolling-renko-feed-field switch-only">
                                    <label class="rolling-renko-feed-switch" for="chkRollingFuturesRenkoEnabled">
                                        <input type="checkbox" id="chkRollingFuturesRenkoEnabled" />
                                        <span class="rolling-renko-feed-switch-track" aria-hidden="true"></span>
                                        <span class="rolling-renko-feed-switch-text">Feed</span>
                                    </label>
                                </div>
                                <div class="rolling-demo-field rolling-renko-feed-field">
                                    <label for="txtRollingFuturesRenkoBoxSize">Renko Box Size</label>
                                    <input type="number" id="txtRollingFuturesRenkoBoxSize" min="1" step="1" value="100" />
                                </div>
                                <div class="rolling-demo-field rolling-renko-feed-field">
                                    <label for="txtRollingFuturesRenkoBaseValue">Base Value</label>
                                    <input type="number" id="txtRollingFuturesRenkoBaseValue" min="0" step="0.01" placeholder="Enter base value" />
                                </div>
                                <div class="rolling-demo-field rolling-renko-feed-field">
                                    <label>Spot Price</label>
                                    <div class="rolling-renko-feed-value-row">
                                        <span class="rolling-renko-feed-value-badge" id="rollingRenkoSpotPrice">--</span>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                        </div>
                        <div class="rolling-renko-feed-meta" id="rollingRenkoFeedMeta"><%= (bIsDemoPage || bIsCoveredLivePage) ? "Delta Renko feed is OFF. Save settings to begin tracking current signal changes." : "Turn the Renko feed ON to begin tracking live box color." %></div>
                        <div class="rolling-demo-event-log" id="rollingRenkoHistoryLog">
                            <div class="rolling-demo-event-empty"><%= (bIsDemoPage || bIsCoveredLivePage) ? "No Renko signals yet." : "No Renko color changes yet." %></div>
                        </div>
                    </div>
                <% } %>

                <% if (bShowTelegramAlertsSection) { %>
                    <div class="app-panel rolling-demo-card">
                        <div class="rolling-demo-card-head">
                            <h2>Telegram Alerts</h2>
                        </div>
                        <p class="app-copy">Alert preferences can follow the same strategy-level model as the paper page while live execution wiring is added server-side.</p>
                        <div class="rolling-demo-notice" id="rollingDualFuturesTelegramNotice">
                            <% if (currentAccount?.telegramChatId) { %>
                                Telegram Chat ID configured: <strong><%= currentAccount.telegramChatId %></strong>
                            <% } else { %>
                                Telegram Chat ID is not set on your profile yet. Add it in <a href="/account/profile">My Profile</a> to receive alerts.
                            <% } %>
                        </div>
                        <div class="rolling-demo-event-prefs">
                            <% for (const eventType of rollingTelegramEventTypes || []) { %>
                                <label class="rolling-demo-check rolling-demo-check-wide" for="dual-live-pref-<%= eventType %>">
                                    <input type="checkbox" class="rolling-demo-telegram-event" id="dual-live-pref-<%= eventType %>" value="<%= eventType %>" />
                                    <span><%= String(eventType || '').split('_').join(' ') %></span>
                                </label>
                            <% } %>
                        </div>
                    </div>
                <% } %>

                <% if (bIsDemoPage || bIsCoveredLivePage) { %>
                    <div class="app-panel rolling-demo-card rolling-rsi-feed-card">
                        <div class="rolling-demo-card-head">
                            <div class="rolling-futures-indicator-head-row">
                                <h2>EMA Trigger</h2>
                                <div class="rolling-renko-feed-header-badges">
                                    <span class="rolling-renko-feed-status-badge off" id="rollingEmaFeedStatus">OFF</span>
                                    <span class="rolling-renko-feed-color-badge neutral" id="rollingEmaCurrentValue">--</span>
                                    <span class="rolling-renko-feed-color-badge neutral" id="rollingEmaSignalState">-</span>
                                </div>
                            </div>
                            <div class="rolling-demo-card-tools">
                                <button class="rolling-demo-icon-btn primary" type="button" id="btnRollingEmaRefresh" title="Refresh EMA data" aria-label="Refresh EMA data">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                                        <path d="M21 3v6h-6" />
                                    </svg>
                                </button>
                                <button class="rolling-demo-icon-btn warn" type="button" id="btnRollingEmaClear" title="Clear EMA history" aria-label="Clear EMA history">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M18 6 6 18" />
                                        <path d="m6 6 12 12" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                        <div class="rolling-renko-feed-grid rolling-renko-feed-grid-ema">
                            <div class="rolling-demo-field rolling-renko-feed-field switch-only">
                                <label class="rolling-renko-feed-switch" for="chkRollingFuturesRenkoEmaEnabled">
                                    <input type="checkbox" id="chkRollingFuturesRenkoEmaEnabled" />
                                    <span class="rolling-renko-feed-switch-track" aria-hidden="true"></span>
                                    <span class="rolling-renko-feed-switch-text">EMA</span>
                                </label>
                            </div>
                            <div class="rolling-demo-field rolling-renko-feed-field">
                                <label for="txtRollingFuturesRenkoEmaLength">EMA Length</label>
                                <input type="number" id="txtRollingFuturesRenkoEmaLength" min="1" step="1" value="<%= bIsCoveredLivePage ? '5' : '20' %>" />
                            </div>
                            <div class="rolling-demo-field rolling-renko-feed-field">
                                <label>Current EMA</label>
                                <div class="rolling-renko-feed-value-row">
                                    <span class="rolling-renko-feed-value-badge" id="rollingRenkoEmaValue">--</span>
                                </div>
                            </div>
                        </div>
                        <div class="rolling-renko-feed-meta" id="rollingEmaFeedMeta">EMA companion is linked to the Renko EMA settings above.</div>
                        <div class="rolling-demo-event-log" id="rollingEmaHistoryLog">
                            <div class="rolling-demo-event-empty">No EMA crossovers yet.</div>
                        </div>
                    </div>
                <% } %>

                <% if (bShowConfirmationSection) { %>
                <div class="app-panel rolling-demo-card">
                    <div class="rolling-demo-card-head">
                        <h2><%= vConfirmationHeading %></h2>
                        <label class="rolling-confirmation-beep-toggle" for="chkRollingFuturesConfirmationSound">
                            <span>Beep</span>
                            <input type="checkbox" role="switch" id="chkRollingFuturesConfirmationSound" checked />
                            <span class="rolling-confirmation-beep-track" aria-hidden="true"></span>
                        </label>
                    </div>
                    <label class="rolling-demo-check rolling-demo-check-wide" for="chkRollingFuturesAutoConfirmLiveActions" style="margin-bottom:12px;">
                        <input type="checkbox" id="chkRollingFuturesAutoConfirmLiveActions" checked />
                        <span><%= vConfirmationAutoText %></span>
                    </label>
                    <div class="rolling-demo-notice" id="rollingDualFuturesConfirmationEmpty">
                        <%= vConfirmationEmpty %>
                    </div>
                    <div id="rollingDualFuturesConfirmationPanel" style="display:none;">
                        <div class="rolling-demo-event-card">
                            <div class="rolling-demo-event-header">
                                <strong id="rollingDualFuturesConfirmationTitle">Pending Confirmation</strong>
                                <span id="rollingDualFuturesConfirmationTime" class="rolling-demo-event-time"></span>
                            </div>
                            <div id="rollingDualFuturesConfirmationMessage" class="rolling-demo-event-message"></div>
                        </div>
                        <div class="rolling-live-modal-actions" style="justify-content:flex-start; margin-top:12px;">
                            <button class="rolling-demo-btn primary" type="button" id="btnRollingDualFuturesConfirmAction">Confirm</button>
                            <button class="rolling-demo-btn warn" type="button" id="btnRollingDualFuturesRejectAction">Reject</button>
                        </div>
                    </div>
                </div>
                <% } %>

                <div class="app-panel rolling-demo-card">
                    <div class="rolling-demo-card-head">
                        <h2>Activity Log</h2>
                        <div class="rolling-demo-card-tools">
                            <button class="rolling-demo-icon-btn primary" type="button" id="btnRollingDualFuturesRefreshEvents" title="Refresh activity log" aria-label="Refresh activity log">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M21 12a9 9 0 1 1-2.64-6.36" />
                                    <path d="M21 3v6h-6" />
                                </svg>
                            </button>
                            <button class="rolling-demo-icon-btn warn" type="button" id="btnRollingDualFuturesClearEvents" title="Clear activity log" aria-label="Clear activity log">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M3 6h18" />
                                    <path d="M8 6V4h8v2" />
                                    <path d="M19 6l-1 14H6L5 6" />
                                    <path d="M10 11v6" />
                                    <path d="M14 11v6" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="rolling-demo-event-log" id="rollingDualFuturesEventLog">
                        <div class="rolling-demo-event-empty"><%= vActivityEmpty %></div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <% if (bShowImportPositionsUi) { %>
        <div class="rolling-live-overlay" id="rollingDualFuturesImportOverlay"></div>
        <section class="app-panel rolling-live-modal" id="rollingDualFuturesImportModal" aria-hidden="true">
            <div class="rolling-live-modal-head">
                <div>
                    <h2 class="rolling-live-modal-title">Import Existing Positions</h2>
                    <p class="app-copy">Pick one or more open Delta Exchange option positions to mirror in the live grid.</p>
                </div>
                <button class="rolling-demo-icon-btn warn" type="button" id="btnRollingDualFuturesCloseImportModal" title="Close import dialog" aria-label="Close import dialog">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18 6 6 18" />
                        <path d="m6 6 12 12" />
                    </svg>
                </button>
            </div>
            <div class="rolling-live-status" id="rollingDualFuturesImportStatus"></div>
            <div class="rolling-live-import-list" id="rollingDualFuturesImportList">
                <div class="rolling-demo-event-empty">Select an API profile to load open live option positions.</div>
            </div>
            <div class="rolling-live-modal-actions">
                <button class="rolling-demo-btn primary" type="button" id="btnRollingDualFuturesApplyImportedPositions">Import Selected</button>
            </div>
        </section>
    <% } %>
    <% if (bIsPaperDemoPage) { %>
        <div class="rolling-live-overlay" id="rollingDualFuturesClosedEditOverlay"></div>
        <section class="app-panel rolling-live-modal" id="rollingDualFuturesClosedEditModal" aria-hidden="true">
            <div class="rolling-live-modal-head">
                <div>
                    <h2 class="rolling-live-modal-title">Edit Closed Position Qty</h2>
                    <p class="app-copy" id="rollingDualFuturesClosedEditSymbol">Update the demo closed-position quantity only.</p>
                </div>
                <button class="rolling-demo-icon-btn warn" type="button" id="btnRollingDualFuturesCloseClosedEditModal" title="Close edit dialog" aria-label="Close edit dialog">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18 6 6 18" />
                        <path d="m6 6 12 12" />
                    </svg>
                </button>
            </div>
            <div class="rolling-live-status" id="rollingDualFuturesClosedEditStatus"></div>
            <div class="rolling-demo-field">
                <label for="txtRollingDualFuturesClosedEditQty">Qty</label>
                <input type="number" min="1" step="1" id="txtRollingDualFuturesClosedEditQty" />
            </div>
            <div class="rolling-live-modal-actions">
                <button class="rolling-demo-btn primary" type="button" id="btnRollingDualFuturesSaveClosedEdit">Save Qty</button>
            </div>
        </section>
    <% } %>
    <script src="/js/rolling-futures-lt.js"></script>
</body>
</html>
