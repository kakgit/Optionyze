<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <%- include('partials/brand-head') %>
    <link rel="stylesheet" href="/css/app-shell.css" />
    <link rel="stylesheet" href="/css/account-menu.css" />
    <link rel="stylesheet" href="/css/mngusers.css" />
    <link rel="stylesheet" href="/css/calendar-spread-support.css" />
    <link rel="stylesheet" href="/css/calendar-spread.css" />
</head>
<body class="app-page">
    <div class="app-layout mngusers-layout" id="manageTradesApp" data-current-account-id="<%= currentAccount?.accountId || '' %>">
        <%- include('partials/app-header', { currentAccount }) %>

        <section class="rolling-demo-section rolling-futures-card-stack">
            <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px;">
                <div>
                    <div class="app-panel rolling-demo-card h-100">
                        <div class="rolling-demo-card-head">
                            <div class="rolling-futures-inline-tools">
                                <span class="rolling-demo-manual-title">Call IV Tracker</span>
                            </div>
                            <div class="rolling-futures-inline-tools">
                                <button type="button" class="btn btn-sm btn-success" id="manageTradesIvStart">Start</button>
                                <button type="button" class="btn btn-sm btn-danger" id="manageTradesIvStop" disabled>Stop</button>
                            </div>
                        </div>
                        <div class="rolling-futures-demo-grid row" style="grid-template-columns: repeat(2, minmax(0, 1fr));">
                            <div class="rolling-demo-field">
                                <label for="manageTradesSlowIvExpiryType">Slow IV Expiry</label>
                                <select id="manageTradesSlowIvExpiryType">
                                    <option value="1">DAILY T+1</option>
                                    <option value="2">DAILY T+2</option>
                                    <option value="4">WEEKLY</option>
                                    <option value="5">BI-WEEKLY</option>
                                    <option value="6" selected>MONTHLY</option>
                                    <option value="7">BI-MONTHLY</option>
                                </select>
                            </div>
                            <div class="rolling-demo-field">
                                <label for="manageTradesSlowIvExpiry">Slow IV Date</label>
                                <input type="date" id="manageTradesSlowIvExpiry" />
                            </div>
                            <div class="rolling-demo-field">
                                <label for="manageTradesFastIvExpiryType">Fast IV Expiry</label>
                                <select id="manageTradesFastIvExpiryType">
                                    <option value="1">DAILY T+1</option>
                                    <option value="2">DAILY T+2</option>
                                    <option value="4" selected>WEEKLY</option>
                                    <option value="5">BI-WEEKLY</option>
                                    <option value="6">MONTHLY</option>
                                    <option value="7">BI-MONTHLY</option>
                                </select>
                            </div>
                            <div class="rolling-demo-field">
                                <label for="manageTradesFastIvExpiry">Fast IV Date</label>
                                <input type="date" id="manageTradesFastIvExpiry" />
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="app-panel rolling-demo-card h-100">
                        <div class="rolling-demo-card-head">
                            <div class="rolling-futures-inline-tools">
                                <span class="rolling-demo-manual-title">Call IV Values</span>
                            </div>
                            <div class="rolling-futures-inline-tools">
                                <button type="button" class="rolling-demo-icon-btn" id="manageTradesIvReset" title="Reset and restart IV tracking" aria-label="Reset and restart IV tracking">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M3 12a9 9 0 1 0 3-6.7" />
                                        <path d="M3 4v5h5" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                        <div id="manageTradesIvLog" style="height: 160px; overflow-y: auto; border: 1px solid rgba(162,180,228,.18); border-radius: 8px; padding: 8px; background: rgba(10,18,38,.88); color: #f3f6ff; font-family: monospace; font-size: 12px;"></div>
                    </div>
                </div>
                <div>
                    <div class="app-panel rolling-demo-card h-100">
                        <div class="rolling-demo-card-head">
                            <div class="rolling-futures-inline-tools">
                                <span class="rolling-demo-manual-title">Call Direction</span>
                            </div>
                        </div>
                        <div id="manageTradesDirectionLog" style="height: 160px; overflow-y: auto; border: 1px solid rgba(162,180,228,.18); border-radius: 8px; padding: 8px; background: rgba(10,18,38,.88); color: #f3f6ff; font-family: monospace; font-size: 12px;"></div>
                    </div>
                </div>
            </div>
        <section class="rolling-demo-section rolling-futures-card-stack" style="margin-top: 12px; overflow: hidden;">
            <div class="app-panel rolling-demo-card">
                <div class="rolling-demo-card-head">
                    <div class="rolling-futures-inline-tools">
                        <span class="rolling-demo-manual-title" id="manageTradesIvChartTitle">BTCUSD Term Structure Shift: Weekly vs. Monthly IV</span>
                    </div>
                </div>
                <style>#manageTradesIvChartScroll::-webkit-scrollbar{height:12px;}#manageTradesIvChartScroll::-webkit-scrollbar-thumb{background:rgba(148,163,184,.6);border-radius:6px;}#manageTradesIvChartScroll::-webkit-scrollbar-track{background:rgba(8,16,36,.8);}</style>
                <div id="manageTradesIvChartScroll" style="overflow-x: auto; overflow-y: hidden; width: 100%; max-width: 100%; position: relative; height: 340px; scrollbar-width: auto; scrollbar-color: rgba(148,163,184,.6) rgba(8,16,36,.8);"><div id="manageTradesIvChartSpacer" style="height: 1px;"></div><canvas id="manageTradesIvChart" width="1000" height="320" style="position: absolute; top: 0; left: 0; height: 320px; max-width: none; background: rgba(10,18,38,.88); border-radius: 8px;"></canvas></div>
            </div>
            <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px;">
                <div>
                    <div class="app-panel rolling-demo-card h-100">
                        <div class="rolling-demo-card-head">
                            <div class="rolling-futures-inline-tools">
                                <span class="rolling-demo-manual-title">Put IV Tracker</span>
                            </div>
                            <div class="rolling-futures-inline-tools">
                                <button type="button" class="btn btn-sm btn-success" id="manageTradesPutIvStart">Start</button>
                                <button type="button" class="btn btn-sm btn-danger" id="manageTradesPutIvStop" disabled>Stop</button>
                            </div>
                        </div>
                        <div class="rolling-futures-demo-grid row" style="grid-template-columns: repeat(2, minmax(0, 1fr));">
                            <div class="rolling-demo-field">
                                <label for="manageTradesPutSlowIvExpiryType">Slow IV Expiry</label>
                                <select id="manageTradesPutSlowIvExpiryType">
                                    <option value="1">DAILY T+1</option>
                                    <option value="2">DAILY T+2</option>
                                    <option value="4">WEEKLY</option>
                                    <option value="5">BI-WEEKLY</option>
                                    <option value="6" selected>MONTHLY</option>
                                    <option value="7">BI-MONTHLY</option>
                                </select>
                            </div>
                            <div class="rolling-demo-field">
                                <label for="manageTradesPutSlowIvExpiry">Slow IV Date</label>
                                <input type="date" id="manageTradesPutSlowIvExpiry" />
                            </div>
                            <div class="rolling-demo-field">
                                <label for="manageTradesPutFastIvExpiryType">Fast IV Expiry</label>
                                <select id="manageTradesPutFastIvExpiryType">
                                    <option value="1">DAILY T+1</option>
                                    <option value="2">DAILY T+2</option>
                                    <option value="4" selected>WEEKLY</option>
                                    <option value="5">BI-WEEKLY</option>
                                    <option value="6">MONTHLY</option>
                                    <option value="7">BI-MONTHLY</option>
                                </select>
                            </div>
                            <div class="rolling-demo-field">
                                <label for="manageTradesPutFastIvExpiry">Fast IV Date</label>
                                <input type="date" id="manageTradesPutFastIvExpiry" />
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    <div class="app-panel rolling-demo-card h-100">
                        <div class="rolling-demo-card-head">
                            <div class="rolling-futures-inline-tools">
                                <span class="rolling-demo-manual-title">Put IV Values</span>
                            </div>
                            <div class="rolling-futures-inline-tools">
                                <button type="button" class="rolling-demo-icon-btn" id="manageTradesPutIvReset" title="Reset and restart IV tracking" aria-label="Reset and restart IV tracking">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M3 12a9 9 0 1 0 3-6.7" />
                                        <path d="M3 4v5h5" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                        <div id="manageTradesPutIvLog" style="height: 160px; overflow-y: auto; border: 1px solid rgba(162,180,228,.18); border-radius: 8px; padding: 8px; background: rgba(10,18,38,.88); color: #f3f6ff; font-family: monospace; font-size: 12px;"></div>
                    </div>
                </div>
                <div>
                    <div class="app-panel rolling-demo-card h-100">
                        <div class="rolling-demo-card-head">
                            <div class="rolling-futures-inline-tools">
                                <span class="rolling-demo-manual-title">Put Direction</span>
                            </div>
                        </div>
                        <div id="manageTradesPutDirectionLog" style="height: 160px; overflow-y: auto; border: 1px solid rgba(162,180,228,.18); border-radius: 8px; padding: 8px; background: rgba(10,18,38,.88); color: #f3f6ff; font-family: monospace; font-size: 12px;"></div>
                    </div>
                </div>
            </div>
        <section class="rolling-demo-section rolling-futures-card-stack" style="margin-top: 12px; overflow: hidden;">
            <div class="app-panel rolling-demo-card">
                <div class="rolling-demo-card-head">
                    <div class="rolling-futures-inline-tools">
                        <span class="rolling-demo-manual-title" id="manageTradesPutIvChartTitle">BTCUSD Put Mark IV Term Structure Shift: Weekly vs. Monthly IV</span>
                    </div>
                </div>
                <style>#manageTradesPutIvChartScroll::-webkit-scrollbar{height:12px;}#manageTradesPutIvChartScroll::-webkit-scrollbar-thumb{background:rgba(148,163,184,.6);border-radius:6px;}#manageTradesPutIvChartScroll::-webkit-scrollbar-track{background:rgba(8,16,36,.8);}</style>
                <div id="manageTradesPutIvChartScroll" style="overflow-x: auto; overflow-y: hidden; width: 100%; max-width: 100%; position: relative; height: 340px; scrollbar-width: auto; scrollbar-color: rgba(148,163,184,.6) rgba(8,16,36,.8);"><div id="manageTradesPutIvChartSpacer" style="height: 1px;"></div><canvas id="manageTradesPutIvChart" width="1000" height="320" style="position: absolute; top: 0; left: 0; height: 320px; max-width: none; background: rgba(10,18,38,.88); border-radius: 8px;"></canvas></div>
            </div>
        </section>
        </section>
    </div>

    <script src="/js/manage-trades.js"></script>
    <script src="/js/websocket-status.js"></script>
</body>
</html>

