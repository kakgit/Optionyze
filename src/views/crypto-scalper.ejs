    <% } %>
    <script>
        // Position Triggers tab switcher. Pure UI scaffolding — no inputs, no API calls.
        (function () {
            const triggers = Array.from(document.querySelectorAll("[data-pos-trg-tab-trigger]"));
            const panels = Array.from(document.querySelectorAll("[data-pos-trg-tab-panel]"));
            if (!triggers.length || !panels.length) {
                return;
            }

            function activate(pKey) {
                const vKey = String(pKey || "").trim().toLowerCase();
                triggers.forEach((objBtn) => {
                    const objIsActive = String(objBtn.dataset.posTrgTabTrigger || "").trim().toLowerCase() === vKey;
                    objBtn.classList.toggle("is-active", objIsActive);
                    objBtn.setAttribute("aria-selected", objIsActive ? "true" : "false");
                    objBtn.setAttribute("tabindex", objIsActive ? "0" : "-1");
                });
                panels.forEach((objPanel) => {
                    const objIsActive = String(objPanel.dataset.posTrgTabPanel || "").trim().toLowerCase() === vKey;
                    objPanel.classList.toggle("is-active", objIsActive);
                    if (objIsActive) {
                        objPanel.removeAttribute("hidden");
                    }
                    else {
                        objPanel.setAttribute("hidden", "");
                    }
                });
            }

            triggers.forEach((objBtn) => {
                objBtn.addEventListener("click", () => activate(objBtn.dataset.posTrgTabTrigger));
            });
        })();
// Position Triggers: live ticker + Save + combined Open/Queued list per symbol tab.
// Polls mark + Pending list + Delta open orders every 3s while a symbol tab is active.
// "Buy/Sell" -> POST /save: places on Delta when maker-valid; otherwise queues locally.
// The list shows both queued (Pending source) and open-on-Delta (Delta source) orders;
// the X button cancels: DELETE /pending/:id for Pending, POST /open-orders/cancel for Delta.
// The ticker only runs while the Auto Trader is ON; it stops as soon as Auto Trader is OFF.
(function () {
    var SYMBOL_TABS = [
        { key: "btc", symbol: "BTC", qtyId: "txtRollingBtcUsdQty" },
        { key: "eth", symbol: "ETH", qtyId: "txtRollingEthUsdQty" },
        { key: "xaut", symbol: "XAUT", qtyId: "txtRollingXautUsdQty" }
    ];
    function capKey(pKey) { return String(pKey || "btc").replace(/^./, function (c) { return c.toUpperCase(); }); }
    var isPageAdmin = String((document.body && document.body.dataset && document.body.dataset.currentAccountAdmin) || "").trim().toLowerCase() === "true";
    var autoTraderOn = false;
    var autoTraderStopping = false;
    var activeTabKey = "btc";
    var sharedMultiplierEl = document.getElementById("txtRollingFuturesStartQty");
    var sharedCalcBtn = document.getElementById("btnRollingFuturesCalcStartQty");
    var arrTabCtls = [];

    // ---- Shared global state: Auto Trader ON/OFF/stopping + active tab ----
    function getActiveTabCtl() {
        for (var i = 0; i < arrTabCtls.length; i++) {
            if (arrTabCtls[i] && arrTabCtls[i].key === activeTabKey) { return arrTabCtls[i]; }
        }
        return arrTabCtls[0] || null;
    }
    function syncAllPolling() {
        for (var i = 0; i < arrTabCtls.length; i++) {
            if (arrTabCtls[i] && typeof arrTabCtls[i].syncPollingState === "function") { arrTabCtls[i].syncPollingState(); }
        }
    }
    function applyAutoTraderState(enabled, stopping) {
        var vNext = Boolean(enabled);
        var vStopping = Boolean(stopping);
        if (vNext === autoTraderOn && vStopping === autoTraderStopping) {
            syncAllPolling();
            return;
        }
        autoTraderOn = vNext;
        autoTraderStopping = vStopping && autoTraderOn;
        for (var i = 0; i < arrTabCtls.length; i++) {
            if (arrTabCtls[i] && typeof arrTabCtls[i].onAutoTraderState === "function") { arrTabCtls[i].onAutoTraderState(); }
        }
        syncAllPolling();
    }

    // ---- Admin-owned Position Trigger defaults (Multiplier / Tolerance / SL / TP) ----
    // Everyone loads the shared global defaults; only admins may edit + save them
    // via POST /api/crypto-scalper/position-triggers/defaults. Normal users get
    // read-only inputs, and these values are never written into user profiles.
    var posTrgSaving = false;
    function applyPosTrgDefaults(d) {
        if (!d) { return; }
        if (d.posTrgMultiplier != null && sharedMultiplierEl) { sharedMultiplierEl.value = String(d.posTrgMultiplier); }
        syncSharedMultiplierToTabs();
        for (var i = 0; i < arrTabCtls.length; i++) {
            var ctl = arrTabCtls[i];
            if (!ctl) { continue; }
            if (d.posTrgTolerance != null && ctl.tolEl) { ctl.tolEl.value = String(d.posTrgTolerance); }
            if (d.posTrgSlPoints != null && ctl.slEl) { ctl.slEl.value = String(d.posTrgSlPoints); }
            if (d.posTrgTpPoints != null && ctl.tpEl) { ctl.tpEl.value = String(d.posTrgTpPoints); }
        }
    }
    function setPosTrgAdminMode() {
        function govern(el) {
            if (!el) { return; }
            el.readOnly = !isPageAdmin;
            el.disabled = !isPageAdmin;
            el.title = isPageAdmin
                ? "Admin default for all users. Changing it saves globally."
                : "Set by admin. Only an admin can change this.";
            if (el.getAttribute("data-pos-trg-multiplier") !== null) {
                el.title = "Multiplier is shared with the BTCUSD tab.";
            }
        }
        govern(sharedMultiplierEl);
        for (var i = 0; i < arrTabCtls.length; i++) {
            var ctl = arrTabCtls[i];
            if (!ctl) { continue; }
            govern(ctl.tolEl);
            govern(ctl.slEl);
            govern(ctl.tpEl);
        }
        if (sharedCalcBtn) {
            sharedCalcBtn.style.display = isPageAdmin ? "" : "none";
            sharedCalcBtn.disabled = !isPageAdmin;
        }
    }
    async function loadPosTrgDefaults() {
        setPosTrgAdminMode();
        try {
            var response = await fetch("/api/crypto-scalper/position-triggers/defaults", { credentials: "same-origin" });
            var json = await response.json().catch(function () { return {}; });
            if (!response.ok || !json || json.status !== "success" || !json.data) { return; }
            if (typeof json.data.isAdmin !== "undefined") {
                isPageAdmin = Boolean(json.data.isAdmin);
                setPosTrgAdminMode();
            }
            applyPosTrgDefaults(json.data);
        }
        catch (e) { /* keep EJS fallback values */ }
    }
    var posTrgSaveTimer = null;
    function queuePosTrgDefaultsSave() {
        if (!isPageAdmin || posTrgSaving) { return; }
        if (posTrgSaveTimer) { clearTimeout(posTrgSaveTimer); }
        posTrgSaveTimer = setTimeout(savePosTrgDefaults, 800);
    }
    async function savePosTrgDefaults() {
        if (!isPageAdmin || posTrgSaving) { return; }
        posTrgSaving = true;
        try {
            var ctl0 = arrTabCtls[0] || null;
            var response = await fetch("/api/crypto-scalper/position-triggers/defaults", {
                method: "POST",
                credentials: "same-origin",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    posTrgMultiplier: sharedMultiplierEl ? sharedMultiplierEl.value : "",
                    posTrgTolerance: ctl0 && ctl0.tolEl ? ctl0.tolEl.value : "",
                    posTrgSlPoints: ctl0 && ctl0.slEl ? ctl0.slEl.value : "",
                    posTrgTpPoints: ctl0 && ctl0.tpEl ? ctl0.tpEl.value : ""
                })
            });
            var result = await response.json().catch(function () { return {}; });
            if (response.ok && result && result.status === "success" && result.data) {
                applyPosTrgDefaults(result.data);
            }
        }
        catch (e) { /* non-fatal; values still apply locally for this session */ }
        finally { posTrgSaving = false; }
    }
    [sharedMultiplierEl].forEach(function (el) {
        if (!el) { return; }
        el.addEventListener("change", queuePosTrgDefaultsSave);
        el.addEventListener("input", function () { syncSharedMultiplierToTabs(); queuePosTrgDefaultsSave(); });
    });
    function syncSharedMultiplierToTabs() {
        if (!sharedMultiplierEl) { return; }
        for (var i = 0; i < arrTabCtls.length; i++) {
            var mctl = arrTabCtls[i];
            if (mctl && mctl.multiplierEl && mctl.multiplierEl !== sharedMultiplierEl) {
                mctl.multiplierEl.value = sharedMultiplierEl.value;
            }
        }
    }
    function bindDefaultsInputsForCtl(ctl) {
        if (!ctl) { return; }
        [ctl.tolEl, ctl.slEl, ctl.tpEl].forEach(function (el) {
            if (!el) { return; }
            el.addEventListener("change", queuePosTrgDefaultsSave);
            el.addEventListener("input", queuePosTrgDefaultsSave);
        });
    }
    function readNumber(el) {
        var v = Number(el && el.value);
        return Number.isFinite(v) ? v : null;
    }

    function statusToTone(s) {
        if (s === "success") { return "success"; }
        if (s === "warning") { return "warning"; }
        return "danger";
    }

    function escapeHtml(s) {
        return String(s == null ? "" : s)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }

    function validate(inp) {
        if (!(inp.qty > 0)) { return "Enter a valid Qty (at least 1 contract)."; }
        if (!(inp.strike > 0)) { return "Enter a valid Strike Price."; }
        if (!(inp.slPoints > 0)) { return "Enter a valid SL Points value."; }
        if (!(inp.tpPoints > 0)) { return "Enter a valid TP Points value."; }
        if (!((inp.strike - inp.slPoints) > 0 && (inp.strike + inp.tpPoints) > 0)) {
            return "Computed SL/TP prices would be non-positive. Reduce SL / TP Points or increase Strike Price.";
        }
        return null;
    }

    

    function isValidMaker(side, strike, markPrice) {
        var vMark = Number(markPrice);
        if (!Number.isFinite(vMark)) { return false; }
        if (side === "BUY") { return vMark > Number(strike); }
        return vMark < Number(strike);
    }

    async function fetchTicker(pSymbol) {
        var response = await fetch("/api/crypto-scalper/position-triggers/ticker?symbol=" + encodeURIComponent(pSymbol), { credentials: "same-origin" });
        var json = await response.json().catch(function () { return {}; });
        if (!response.ok || !json || json.status !== "success" || !json.data) {
            throw new Error((json && json.message) ? json.message : ("Ticker fetch failed (HTTP " + response.status + ")."));
        }
        return json.data;
    }

    function createPosTrgTabCtl(tabKey, symbol, qtyId) {
    var tabCap = capKey(tabKey);
    var buyBtn = document.getElementById("btnPosTrg" + tabCap + "Buy");
    var sellBtn = document.getElementById("btnPosTrg" + tabCap + "Sell");
    var statusEl = document.getElementById("rollingPosTrg" + tabCap + "Status");
    var qtyEl = document.getElementById(qtyId);
    var multiplierEl = document.querySelector('#rollingPosTrgPanel' + tabCap + ' [data-pos-trg-multiplier]') || sharedMultiplierEl;
    var strikeEl = document.getElementById("txtPosTrg" + tabCap + "BuyStrike");
    var slEl = document.getElementById("txtPosTrg" + tabCap + "SlPoints");
    var tpEl = document.getElementById("txtPosTrg" + tabCap + "TpPoints");
    var tolEl = document.getElementById("txtPosTrg" + tabCap + "Tolerance");
    var tickerBox = document.getElementById("rollingPosTrg" + tabCap + "Ticker");
    var tickerPriceEl = tickerBox ? tickerBox.querySelector("[data-pos-trg-ticker-price]") : null;
    var tickerVsEl = tickerBox ? tickerBox.querySelector("[data-pos-trg-ticker-vs]") : null;
    var pendingEmptyEl = document.getElementById("rollingPosTrg" + tabCap + "PendingEmpty");
    var pendingTableEl = document.getElementById("rollingPosTrg" + tabCap + "PendingTable");
    var pendingBodyEl = document.getElementById("rollingPosTrg" + tabCap + "PendingBody");
    var watcherBadgeEl = document.getElementById("rollingPosTrg" + tabCap + "WatcherBadge");
    if (!buyBtn || !sellBtn || !statusEl || !qtyEl || !strikeEl || !slEl || !tpEl || !tolEl || !pendingEmptyEl || !pendingTableEl || !pendingBodyEl) {
        return null;
    }
    bindDefaultsInputsForCtl({ tolEl: tolEl, slEl: slEl, tpEl: tpEl });
    var ctl = {
        key: tabKey, symbol: symbol, tabCap: tabCap,
        tolEl: tolEl, slEl: slEl, tpEl: tpEl, multiplierEl: multiplierEl,
        pollInterval: null, lastMarkPrice: null,
        setStatus: null, readFormInputs: null, validate: null,
        renderTicker: null, setTickerIdle: null,
        refreshLists: null, tickOnce: null,
        syncPollingState: null, onAutoTraderState: null, syncManualTriggerButtons: null,
        executeSave: null
    };
    ctl.isTabActive = function () { return activeTabKey === tabKey; };
    ctl.setStatus = function (message, tone) {
        statusEl.textContent = String(message || "");
        statusEl.className = "rolling-pos-trg-status show " + (tone || "");
    };
    ctl.readFormInputs = function () {
        var vBaseQty = Math.max(1, Math.floor(readNumber(qtyEl) || 1));
        var vMultiplier = Math.max(1, Math.floor(readNumber(sharedMultiplierEl) || readNumber(multiplierEl) || 1));
        return {
            qty: vBaseQty * vMultiplier,
            strike: readNumber(strikeEl),
            slPoints: readNumber(slEl),
            tpPoints: readNumber(tpEl),
            tolerance: Math.max(1, Math.floor(readNumber(tolEl) || 20))
        };
    };
    ctl.validate = function (inp) {
        if (!(inp.qty > 0)) { return "Enter a valid Qty (at least 1 contract)."; }
        if (!(inp.strike > 0)) { return "Enter a valid Strike Price."; }
        if (!(inp.slPoints > 0)) { return "Enter a valid SL Points value."; }
        if (!(inp.tpPoints > 0)) { return "Enter a valid TP Points value."; }
        if (!((inp.strike - inp.slPoints) > 0 && (inp.strike + inp.tpPoints) > 0)) {
            return "Computed SL/TP prices would be non-positive. Reduce SL / TP Points or increase Strike Price.";
        }
        return null;
    };
    ctl.renderTicker = function (markPrice, strike) {
        if (!tickerBox || !tickerPriceEl) { return; }
        tickerPriceEl.textContent = Number.isFinite(markPrice) ? markPrice.toFixed(2) : "--";
        tickerBox.classList.remove("above-strike", "below-strike");
        if (tickerVsEl) { tickerVsEl.textContent = ""; }
        if (!Number.isFinite(markPrice)) { return; }
        if (Number.isFinite(strike) && strike > 0) {
            var diff = markPrice - strike;
            var sign = diff > 0 ? "above" : (diff < 0 ? "below" : "at");
            tickerBox.classList.add(diff > 0 ? "above-strike" : (diff < 0 ? "below-strike" : ""));
            tickerVsEl.textContent = sign + " strike by " + Math.abs(diff).toFixed(2);
        }
    }

    ctl.setTickerIdle = function (message) {
        ctl.lastMarkPrice = null;
        if (!tickerBox || !tickerPriceEl) { return; }
        tickerPriceEl.textContent = "--";
        tickerBox.classList.remove("above-strike", "below-strike");
        if (tickerVsEl) { tickerVsEl.textContent = message || ""; }
    }

    ctl.saveOrder = async function (inp) {
        var response = await fetch("/api/crypto-scalper/position-triggers/save", {
            method: "POST",
            credentials: "same-origin",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                symbol: symbol,
                side: inp.side,
                qty: inp.qty,
                limitPrice: inp.strike,
                slPoints: inp.slPoints,
                tpPoints: inp.tpPoints,
                tolerance: inp.tolerance
            })
        });
        var result = await response.json().catch(function () { return {}; });
        return {
            status: response.status,
            body: result,
            tone: statusToTone(result && result.status),
            httpOk: response.ok
        };
    }

    ctl.fetchPending = async function () {
        var response = await fetch("/api/crypto-scalper/position-triggers/pending", { credentials: "same-origin" });
        var json = await response.json().catch(function () { return {}; });
        if (!response.ok || !json || json.status !== "success" || !Array.isArray(json.data)) {
            throw new Error((json && json.message) ? json.message : ("Pending list fetch failed (HTTP " + response.status + ")."));
        }
        return json.data;
    }

    ctl.fetchDeltaOpenOrders = async function (symbol) {
        var response = await fetch("/api/crypto-scalper/position-triggers/open-orders?symbol=" + encodeURIComponent(symbol), { credentials: "same-origin" });
        var json = await response.json().catch(function () { return {}; });
        if (!response.ok || !json || json.status !== "success" || !json.data) {
            return { buy: [], sell: [] };
        }
        return json.data;
    }

    ctl.deletePending = async function (id) {
        var response = await fetch("/api/crypto-scalper/position-triggers/pending/" + encodeURIComponent(id), {
            method: "DELETE",
            credentials: "same-origin"
        });
        var json = await response.json().catch(function () { return {}; });
        if (!response.ok) {
            throw new Error((json && json.message) ? json.message : ("Delete pending failed (HTTP " + response.status + ")."));
        }
        return json;
    }

    ctl.cancelDeltaOrder = async function (orderId, symbol, productId) {
        var response = await fetch("/api/crypto-scalper/position-triggers/open-orders/cancel", {
            method: "POST",
            credentials: "same-origin",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ orderId: orderId, symbol: symbol || "BTC", productId: (productId != null && productId !== "" ? Number(productId) : null) })
        });
        var json = await response.json().catch(function () { return {}; });
        if (!response.ok) {
            throw new Error((json && json.message) ? json.message : ("Delta cancel failed (HTTP " + response.status + ")."));
        }
        return json;
    }


    ctl.distanceForPending = function (pRecord, markPrice) {
        var strike = Number(pRecord.strike || 0);
        var tol = Math.max(1, Number(pRecord.tolerance || 1));
        if (!Number.isFinite(markPrice) || !Number.isFinite(strike)) { return null; }
        var absDist = Math.abs(markPrice - strike);
        var direction = markPrice > strike ? "above" : (markPrice < strike ? "below" : "at");
        var side = String(pRecord.side || "").toUpperCase();
        var validMaker = isValidMaker(side, strike, markPrice);
        return { absDist: absDist, direction: direction, ready: validMaker && absDist <= tol, withinTolerance: absDist <= tol };
    }

    ctl.renderOrders = function (pPending, pDeltaBuy, pDeltaSell, markPrice) {
        var arrRows = [];
        var arrPending = Array.isArray(pPending) ? pPending : [];
        for (var i = 0; i < arrPending.length; i++) {
            var p = arrPending[i];
            var side = String(p.side || "").toUpperCase();
            var dist = ctl.distanceForPending(p, markPrice);
            arrRows.push({
                kind: "pending",
                id: String(p.id || ""),
                side: side,
                strike: Number(p.strike || 0),
                sizeLabel: String(p.qty || 1),
                sltpLabel: ((Number(p.slPoints) || 0).toFixed(0) + " / " + (Number(p.tpPoints) || 0).toFixed(0)),
                tolLabel: ((Number(p.tolerance) || 0).toFixed(0)),
                source: "Pending",
                distanceClass: dist && dist.ready ? "ready" : (dist && dist.direction === "above" ? "above-strike" : (dist && dist.direction === "below" ? "below-strike" : "")),
                distanceText: dist ? (dist.direction === "at" ? "at strike" : (dist.absDist.toFixed(2) + " " + dist.direction)) : "--",
                cancelTitle: "Cancel this pending trigger"
            });
        }
        var arrBuy = Array.isArray(pDeltaBuy) ? pDeltaBuy : [];
        for (var j = 0; j < arrBuy.length; j++) {
            var o = arrBuy[j];
            arrRows.push({
                kind: "delta",
                id: String(o.orderId || ""),
                productId: (o.productId != null ? o.productId : null),
                side: "BUY",
                strike: Number(o.limitPrice || 0),
                sizeLabel: ((Number(o.filledSize) || 0) + " / " + (Number(o.size) || 0)),
                sltpLabel: "--",
                tolLabel: "--",
                source: "Delta",
                distanceClass: "",
                distanceText: "id " + String(o.orderId || "?").slice(0, 14),
                cancelTitle: "Cancel this order on Delta Exchange"
            });
        }
        var arrSell = Array.isArray(pDeltaSell) ? pDeltaSell : [];
        for (var k = 0; k < arrSell.length; k++) {
            var oo = arrSell[k];
            arrRows.push({
                kind: "delta",
                id: String(oo.orderId || ""),
                productId: (oo.productId != null ? oo.productId : null),
                side: "SELL",
                strike: Number(oo.limitPrice || 0),
                sizeLabel: ((Number(oo.filledSize) || 0) + " / " + (Number(oo.size) || 0)),
                sltpLabel: "--",
                tolLabel: "--",
                source: "Delta",
                distanceClass: "",
                distanceText: "id " + String(oo.orderId || "?").slice(0, 14),
                cancelTitle: "Cancel this order on Delta Exchange"
            });
        }

        if (arrRows.length === 0) {
            pendingEmptyEl.hidden = false;
            pendingTableEl.hidden = true;
            return;
        }
        pendingEmptyEl.hidden = true;
        pendingTableEl.hidden = false;
        var html = arrRows.map(function (r) {
            var sideCls = r.side === "SELL" ? "sell" : "buy";
            var sourceCls = r.kind === "delta" ? "on-delta" : "pending-local";
            var safeId = escapeHtml(r.id);
            var safePid = escapeHtml(r.productId != null ? String(r.productId) : '');
            var cancelBtnHtml = '<button type=\u0022button\u0022 class=\u0022rolling-pos-trg-pending-cancel-btn\u0022 data-pos-trg-cancel-kind=\u0022' + escapeHtml(r.kind) + '\u0022 data-pos-trg-cancel-id=\u0022' + safeId + '\u0022 data-pos-trg-cancel-pid=\u0022' + safePid + '\u0022 title=\u0022' + escapeHtml(r.cancelTitle) + '\u0022 aria-label=\u0022Cancel order\u0022>\u00d7</button>';
            return ""
                + "<tr data-pos-trg-row-kind=\"" + escapeHtml(r.kind) + "\" data-pos-trg-row-id=\"" + safeId + "\">"
                + "<td class=\"rolling-pos-trg-pending-side " + sideCls + "\">" + escapeHtml(r.side) + "</td>"
                + "<td>" + escapeHtml(r.sizeLabel) + "</td>"
                + "<td>" + escapeHtml(r.strike.toFixed(2)) + "</td>"
                + "<td>" + escapeHtml(r.sltpLabel) + "</td>"
                + "<td>" + escapeHtml(r.tolLabel) + "</td>"
                + "<td class=\"rolling-pos-trg-pending-distance " + (r.distanceClass || "") + "\">" + escapeHtml(r.distanceText) + "</td>"
                + "<td class=\"rolling-pos-trg-pending-source " + sourceCls + "\">" + escapeHtml(r.source) + "</td>"
                + "<td class=\"rolling-pos-trg-pending-cancel-col\">" + cancelBtnHtml + "</td>"
                + "</tr>";
        }).join("");
        pendingBodyEl.innerHTML = html;
    }

    ctl.fetchWatcherStatus = async function () {
        var response = await fetch("/api/crypto-scalper/position-triggers/watcher-status", { credentials: "same-origin" });
        var json = await response.json().catch(function () { return {}; });
        if (!response.ok || !json || json.status !== "success" || !json.data) {
            throw new Error((json && json.message) ? json.message : "Watcher status fetch failed.");
        }
        return json.data;
    }

    ctl.renderWatcherBadge = function (status) {
        if (!watcherBadgeEl) { return; }
        var vStopping = Boolean(status && status.cryptoScalperStopRequested);
        var vRunning = Boolean(status && status.watcherRunning) && !vStopping;
        var vPending = Number((status && status.pendingCount) || 0);
        watcherBadgeEl.className = "rolling-pos-trg-watcher-badge" + (vRunning ? " is-running" : " is-stopped");
        watcherBadgeEl.textContent = vStopping
            ? "Server: stopping (waiting for flat)"
            : (vRunning ? ("Server: watching (" + vPending + " queued)") : "Server: stopped");
        watcherBadgeEl.title = vStopping
            ? "Auto Trader stop was requested. No new strategy orders will be placed. Server checks Delta every 3 minutes until positions and unfilled entry orders are flat."
            : (vRunning
                ? ("Server-side watcher is running every " + Number(status.intervalMs || 0) + "ms. Queued orders auto-fire even if the browser is closed.")
                : "Server-side watcher is not running. Turn Auto Trader ON to start it.");
    }

    ctl.refreshWatcherStatus = async function () {
        try {
            ctl.renderWatcherBadge(await ctl.fetchWatcherStatus());
        }
        catch (e) {
            if (watcherBadgeEl) {
                watcherBadgeEl.className = "rolling-pos-trg-watcher-badge is-stopped";
                watcherBadgeEl.textContent = "Server: unavailable";
            }
        }
    }

    ctl.pendingMatchesSymbol = function (pRow) {
        var vSym = String((pRow && (pRow.symbol || pRow.contractSymbol)) || "").trim().toUpperCase();
        if (vSym === symbol || vSym === symbol + "USD") { return true; }
        return false;
    };
    ctl.refreshLists = async function () {
        var arrPending = [];
        var objOpen = { buy: [], sell: [] };
        try {
            var arrAll = await ctl.fetchPending();
            arrPending = (Array.isArray(arrAll) ? arrAll : []).filter(function (r) { return ctl.pendingMatchesSymbol(r); });
        } catch (e) { /* ignore */ }
        try { objOpen = await ctl.fetchDeltaOpenOrders(symbol); } catch (e) { objOpen = { buy: [], sell: [] }; }
        ctl.renderOrders(arrPending, objOpen && objOpen.buy, objOpen && objOpen.sell, ctl.lastMarkPrice);
        return { pending: arrPending, open: objOpen };
    }

    ctl.tickOnce = async function () {
        try {
            var t = await fetchTicker(symbol);
            var mp = Number(t.markPrice);
            ctl.lastMarkPrice = Number.isFinite(mp) ? mp : null;
            ctl.renderTicker(ctl.lastMarkPrice, readNumber(strikeEl));
        }
        catch (e) {
            ctl.lastMarkPrice = null;
        }

        // NOTE: the auto-fire decision now lives on the server (Position Trigger
        // watcher) so queued orders keep firing even when the browser is closed.
        // The browser only refreshes and displays the list.
        await ctl.refreshWatcherStatus();
        await ctl.refreshLists();
    }

    ctl.stopPolling = function () {
        if (ctl.pollInterval) { clearInterval(ctl.pollInterval); ctl.pollInterval = null; }
    }

    ctl.startPolling = function () {
        ctl.stopPolling();
        ctl.pollInterval = setInterval(ctl.tickOnce, 3000);
    }

    // The ticker only runs while the Auto Trader is actively ON and the BTC tab
    // is the active tab. A requested stop immediately pauses the ticker too.
    ctl.syncPollingState = function () {
        if (autoTraderOn && !autoTraderStopping && ctl.isTabActive()) {
            if (!ctl.pollInterval) {
                ctl.setTickerIdle("");
                void ctl.tickOnce();
                ctl.startPolling();
            }
        }
        else {
            ctl.stopPolling();
            if (autoTraderStopping) {
                ctl.setTickerIdle("Auto Trader STOPPING");
                if (tickerVsEl) { tickerVsEl.textContent = "Auto Trader STOPPING"; }
            }
            else if (!autoTraderOn) {
                ctl.setTickerIdle("Auto Trader OFF");
                // Clear the distance hints since no live price is available.
                if (tickerVsEl) { tickerVsEl.textContent = "Auto Trader OFF"; }
            }
        }
    }

    ctl.onAutoTraderState = function () {
        if (autoTraderStopping) {
            ctl.setTickerIdle("Auto Trader STOPPING");
            ctl.setStatus("Auto Trader stop requested. Ticker paused; waiting for Delta to confirm flat. No new strategy orders will be placed.", "warning");
            ctl.syncManualTriggerButtons();
        }
        else if (!autoTraderOn) {
            ctl.setTickerIdle("Auto Trader OFF");
            ctl.setStatus("Auto Trader is OFF. Ticker and auto-fire are paused.", "warning");
            ctl.syncManualTriggerButtons();
        }
        else {
            ctl.setTickerIdle("");
            ctl.syncManualTriggerButtons();
        }
    };


    ctl.syncManualTriggerButtons = function () {
        var vDisabled = Boolean(autoTraderStopping);
        [buyBtn, sellBtn].forEach(function (btn) {
            if (btn) {
                if (!btn.getAttribute("data-pos-trg-original-title")) {
                    btn.setAttribute("data-pos-trg-original-title", btn.title || "");
                }
                btn.disabled = vDisabled;
                btn.title = vDisabled
                    ? "Auto Trader stop is in progress. Buttons resume after Delta confirms flat."
                    : (btn.getAttribute("data-pos-trg-original-title") || "");
            }
        });
    }


    ctl.executeSave = async function (side, buttonEl) {
        buttonEl.disabled = true;
        ctl.setStatus("Saving " + (side === "BUY" ? "Buy" : "Sell") + " position trigger...", "info");
        try {
            var inp = ctl.readFormInputs();
            inp.side = side;
            var err = ctl.validate(inp);
            if (err) {
                ctl.setStatus(err, "warning");
                return;
            }
            var resSave = await ctl.saveOrder(inp);
            var msg = (resSave.body && resSave.body.message) ? resSave.body.message
                : ("Save failed (HTTP " + resSave.status + ").");
            ctl.setStatus(msg, resSave.tone);
            if (resSave.httpOk) {
                await ctl.refreshLists();
            }
        }
        catch (objErr) {
            ctl.setStatus(objErr && objErr.message ? objErr.message : String(objErr), "danger");
        }
        finally {
            ctl.syncManualTriggerButtons();
        }
    }

    buyBtn.addEventListener("click", function () { void ctl.executeSave("BUY", buyBtn); });
    sellBtn.addEventListener("click", function () { void ctl.executeSave("SELL", sellBtn); });

    pendingBodyEl.addEventListener("click", async function (ev) {
        var t = ev.target;
        if (!(t instanceof HTMLElement)) { return; }
        if (!t.classList.contains("rolling-pos-trg-pending-cancel-btn")) { return; }
        var vKind = t.getAttribute("data-pos-trg-cancel-kind") || "";
        var vId = t.getAttribute("data-pos-trg-cancel-id") || "";
        if (!vId) { return; }
        t.disabled = true;
        try {
            if (vKind === "delta") {
                await ctl.cancelDeltaOrder(vId, symbol, t.getAttribute("data-pos-trg-cancel-pid") || null);
                ctl.setStatus("Delta order " + vId + " cancelled.", "info");
            }
            else {
                await ctl.deletePending(vId);
                ctl.setStatus("Pending trigger removed: " + symbol, "info");
            }
        }
        catch (objErr) {
            ctl.setStatus(objErr && objErr.message ? objErr.message : String(objErr), "warning");
            t.disabled = false;
            return;
        }
        await ctl.refreshLists();
    });

    return ctl;
    }

    // ---- Instantiate all symbol tabs (BTC / ETH / XAUT) ----
    arrTabCtls = SYMBOL_TABS.map(function (t) { return createPosTrgTabCtl(t.key, t.symbol, t.qtyId); }).filter(Boolean);

    // Tab switching: set the active tab key, then re-sync polling across all
    // tabs so only the visible tab polls the ticker while Auto Trader is ON.
    Array.prototype.forEach.call(document.querySelectorAll("[data-pos-trg-tab-trigger]"), function (btn) {
        btn.addEventListener("click", function () {
            activeTabKey = String(btn.getAttribute("data-pos-trg-tab-trigger") || "btc").toLowerCase();
            syncAllPolling();
        });
    });
    var vInitialActiveTab = document.querySelector("[data-pos-trg-tab-trigger].is-active");
    if (vInitialActiveTab) {
        activeTabKey = String(vInitialActiveTab.getAttribute("data-pos-trg-tab-trigger") || "btc").toLowerCase();
    }

    // Listen for Auto Trader state broadcasts from the main page script (single
    // global listener). The raw enabled flag stays true while paused for the
    // stop-drain, so use the effective flag for the ticker and the raw flag for
    // the stopping label.
    window.addEventListener("optionyze:autotrader", function (ev) {
        var d = ev && ev.detail ? ev.detail : {};
        var vStopping = Boolean(d.stopping);
        var vEffectiveEnabled = ("effectiveEnabled" in d) ? Boolean(d.effectiveEnabled) : Boolean(d.enabled);
        applyAutoTraderState(vEffectiveEnabled || (vStopping && Boolean(d.enabled)), vStopping);
    });

    // Load admin-owned defaults now that all tab controls exist, then sync.
    loadPosTrgDefaults();
    syncAllPolling();

    // Initial Auto Trader state comes from the server runtime endpoint.
    (async function initAutoTraderState() {
        try {
            var response = await fetch("/api/crypto-scalper/runtime", { credentials: "same-origin" });
            var json = await response.json().catch(function () { return {}; });
            if (response.ok && json && json.status === "success" && json.data) {
                var vStopping = Boolean(json.data.state && json.data.state.cryptoScalperStopDrain && json.data.state.cryptoScalperStopDrain.requested);
                applyAutoTraderState(Boolean(json.data.autoTraderEnabled), vStopping);
            }
        }
        catch (e) {
            // Runtime unavailable; leave the ticker stopped.
        }
    })();
// Manual Settings collapse toggle
    (function() {
        var btn = document.getElementById('btnManualSettingsCollapse');
        var body = document.getElementById('rollingManualSettingsBody');
        if (!btn || !body) return;
        btn.addEventListener('click', function() {
            var collapsed = body.classList.toggle('is-collapsed');
            btn.classList.toggle('is-collapsed', collapsed);
            btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
            btn.setAttribute('title', collapsed ? 'Expand Manual Settings' : 'Collapse Manual Settings');
            btn.setAttribute('aria-label', collapsed ? 'Expand Manual Settings' : 'Collapse Manual Settings');
        });
    })();
})();
</script>
    <script src="/js/crypto-scalper.js"></script>
    <script src="/js/websocket-status.js"></script>
</body>
