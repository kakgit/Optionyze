<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <%- include('partials/brand-head') %>
    <link rel="stylesheet" href="/css/app-shell.css" />
    <link rel="stylesheet" href="/css/account-menu.css" />
    <link rel="stylesheet" href="/css/rolling-options-pt-de.css" />
    <link rel="stylesheet" href="/css/rolling-futures-lt-common.css" />
    <link rel="stylesheet" href="/css/rolling-futures-lt-dual.css" />
</head>
  <%
    const vPageVariantRaw = String(pageVariant || "live").trim().toLowerCase();
    const vPageVariant = vPageVariantRaw === "demo"
        ? "demo"
        : (vPageVariantRaw === "strangle"
            ? "strangle"
            : (vPageVariantRaw === "strangle-demo"
                ? "strangle-demo"
                : (vPageVariantRaw === "renko" ? "renko" : "live")));
    const bIsDemoPage = vPageVariant === "demo";
    const bIsStranglePage = vPageVariant === "strangle";
    const bIsStrangleDemoPage = vPageVariant === "strangle-demo";
    const bIsRenkoPage = vPageVariant === "renko";
    const bIsPaperDemoPage = bIsDemoPage || bIsStrangleDemoPage;
    const bIsCoveredLivePage = !bIsDemoPage && !bIsStranglePage && !bIsStrangleDemoPage && !bIsRenkoPage;
    const bShowRenkoSection = bIsDemoPage || bIsRenkoPage || bIsCoveredLivePage;
    const bIsStrangleLikePage = bIsStranglePage || bIsStrangleDemoPage || bIsRenkoPage;
    const bShowLiveSupportSections = !bIsDemoPage && !bIsStrangleDemoPage && !bIsCoveredLivePage;
    const bShowConfirmationSection = !bIsDemoPage && !bIsStrangleDemoPage && (bShowLiveSupportSections || bIsCoveredLivePage);
    const bShowTelegramAlertsSection = false;
    const bShowImportPositionsUi = !bIsPaperDemoPage;
    const vStrategyLabel = "Crypto Scalper";
    const vPageHeading = bIsDemoPage ? "Options Demo" : (bIsStrangleDemoPage ? "Strangle Demo" : `${vStrategyLabel} - Live`);
    const vEndpointBase = "/api/crypto-scalper";
    const vOpenPositionsEmpty = bIsPaperDemoPage
        ? "No demo positions are currently shown."
        : `Select an API profile and load live ${bIsRenkoPage ? "options-scalper" : ((bIsStranglePage || bIsStrangleDemoPage) ? "strangle-option" : "covered-option")} positions from Delta Exchange.`;
    const vClosedPositionsEmpty = bIsPaperDemoPage
        ? "No demo trade history found for the selected date range."
        : "No Delta fill history found for the selected date range.";
    const vConfirmationHeading = "Confirmation";
    const vConfirmationAutoText = `Auto-confirm all ${bIsRenkoPage ? "options-scalper" : ((bIsStranglePage || bIsStrangleDemoPage) ? "strangle" : "covered")} live actions`;
    const vConfirmationEmpty = "No live action is waiting for confirmation.";
    const vActivityEmpty = bIsPaperDemoPage ? "No demo activity has been logged yet." : "No live activity has been logged yet.";
    const vClearOpenPositionsTitle = bIsPaperDemoPage ? "Clear all demo open positions locally" : "Clear all imported open positions locally";
    const vRefreshOpenPositionsTitle = bIsPaperDemoPage ? "Refresh demo positions" : "Refresh open positions";
    const vKillSwitchTitle = bIsPaperDemoPage ? "Kill switch to close demo option legs" : "Kill switch to close live option legs";
    const vClearClosedPositionsTitle = bIsPaperDemoPage ? "Clear all demo closed positions locally" : "";
    const vRefreshClosedTitle = bIsPaperDemoPage ? "Refresh closed demo positions" : "Refresh closed positions from Delta Exchange";
  %>
  <body class="app-page"
        data-rolling-futures-live="covered"
        data-rolling-futures-variant="<%= vPageVariant %>"
        data-rolling-futures-endpoint-base="<%= vEndpointBase %>"
        data-rolling-futures-strategy-label="<%= vStrategyLabel %>"
        data-manual-trader-label="Manual Trader"
        data-exec-strategy-enabled="<%= currentAccount?.execStrategy ? 'true' : 'false' %>"
        data-current-account-id="<%= currentAccount?.accountId || '' %>"
        data-current-account-admin="<%= currentAccount?.isAdmin ? 'true' : 'false' %>"
        data-current-account-verifier="<%= currentAccount?.isVerifier ? 'true' : 'false' %>"
        data-current-account-full-name="<%= currentAccount?.fullName || '' %>"
        data-current-account-email="<%= currentAccount?.email || '' %>"
        data-current-account-telegram-chat-id="<%= currentAccount?.telegramChatId || '' %>">
    <div class="app-layout rolling-demo-layout">
        <%- include('partials/app-header', { currentAccount }) %>


        <section class="rolling-demo-section rolling-manual-settings-section">
            <div class="app-panel rolling-demo-card">
                <div class="rolling-demo-card-head">
                    <h2 class="rolling-manual-settings-title">Manual Settings</h2>
                    <div class="rolling-demo-card-tools" aria-label="Manual Settings">
                        <% if (currentAccount?.isVerifier) { %>
                            <div class="rolling-live-admin-target-head">
                                <div class="rolling-demo-field rolling-live-admin-target-field">
                                    <select id="ddlRollingDualAdminTargetUser">
                                        <option value="">Loading running users...</option>
                                    </select>
                                </div>
                                <div class="rolling-live-admin-target-meta" id="rollingDualAdminTargetMeta">Select a running <%= vStrategyLabel %> user to load settings and positions.</div>
                            </div>
                        <% } %>
                        
                    <button class="rolling-demo-btn warn" type="button" id="btnRollingFuturesDemoAutoTrader" title="Toggle Auto Trader" aria-label="Toggle Auto Trader" style="width:auto">Auto Trader</button>
                    <button class="rolling-manual-settings-collapse-btn" type="button" id="btnManualSettingsCollapse" title="Collapse Manual Settings" aria-label="Collapse Manual Settings" aria-expanded="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M7 9l5 5 5-5" />
                        </svg>
                    </button>
                    </div>
                </div>
                <div class="rolling-manual-settings-body is-collapsed" id="rollingManualSettingsBody">
                    <div class="rolling-live-status" id="rollingDualFuturesConnectionStatus"></div>
<div class="rolling-live-status" id="rollingDualFuturesPageStatus"></div>
                    <div class="rolling-live-connection-grid">
    <div class="rolling-demo-metric">
        <div class="rolling-demo-metric-label api-name-label">
    API Name
    <select id="ddlRollingDualFuturesApiProfile">
        <option value="">Select API profile</option>
    </select>
</div>
    </div>
    <div class="rolling-demo-metric">
        <div class="rolling-demo-metric-label connection-status-label">
    Connection Status
    <button class="rolling-demo-icon-btn primary" type="button" id="btnRollingDualFuturesCheckConnection" title="Check Delta connection" aria-label="Check Delta connection">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 12a9 9 0 1 1-2.64-6.36" />
            <path d="M21 3v6h-6" />
        </svg>
    </button>
</div>
<div class="rolling-demo-metric-value" id="rollingDualFuturesConnectionStateValue">Not Selected</div>
    </div>
    <div class="rolling-demo-metric">
        <div class="rolling-demo-metric-label rolling-live-ip-label">
    Whitelist IP
    <button class="rolling-live-copy-ip-btn" type="button" id="btnRollingDualFuturesCopyWhitelistIp" title="Copy this server IP for Delta Exchange whitelist" aria-label="Copy this server IP for Delta Exchange whitelist">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 9h10v12H9z" />
            <path d="M5 15V5h10" />
        </svg>
    </button>
</div>
<div class="rolling-demo-metric-value" id="rollingDualFuturesWhitelistIpValue">-</div>
</div>
    <div class="rolling-demo-metric">
        <div class="rolling-demo-metric-label">Total Balance</div>
        <div class="rolling-demo-metric-value" id="rollingDualFuturesTotalBalanceValue">-</div>
    </div>
</div>
    <div class="rolling-demo-grid" style="grid-template-columns:repeat(3, minmax(0, 1fr)); margin-top:14px;">
        <div class="rolling-demo-field">
            <label for="txtRollingBtcUsdQty">BTCUSD Qty</label>
            <input type="number" id="txtRollingBtcUsdQty" name="txtRollingBtcUsdQty" min="1" step="1" value="1" title="Number of contracts (Delta size). 1 contract = 0.001 BTC for BTCUSD." placeholder="e.g. 1" />
        </div>
        <div class="rolling-demo-field">
            <label for="txtRollingEthUsdQty">ETHUSD Qty</label>
            <input type="number" id="txtRollingEthUsdQty" name="txtRollingEthUsdQty" min="1" step="1" value="1" title="Number of contracts (Delta size). 1 contract = 0.01 ETH for ETHUSD." placeholder="e.g. 1" />
        </div>
        <div class="rolling-demo-field">
            <label for="txtRollingXautUsdQty">XAUTUSD Qty</label>
            <input type="number" id="txtRollingXautUsdQty" name="txtRollingXautUsdQty" min="1" step="1" value="1" title="Number of contracts (Delta size). 1 contract = 0.01 XAUT for XAUTUSD." placeholder="e.g. 1" />
        </div>
    </div>
            </div>
                </div>
        </section>
        <section class="rolling-demo-section rolling-pos-trg-section">
            <div class="app-panel rolling-demo-card">
                <div class="rolling-demo-card-head">
                    <h2 class="rolling-pos-trg-title">Position Triggers</h2>
                    <div class="rolling-demo-card-tools" aria-label="Position Triggers symbol tabs">
                        <button type="button" class="rolling-pos-trg-tab-trigger is-active" data-pos-trg-tab-trigger="btc" aria-controls="rollingPosTrgPanelBtc" aria-selected="true">BTCUSD</button>
                        <button type="button" class="rolling-pos-trg-tab-trigger" data-pos-trg-tab-trigger="eth" aria-controls="rollingPosTrgPanelEth" aria-selected="false" tabindex="-1">ETHUSD</button>
                        <button type="button" class="rolling-pos-trg-tab-trigger" data-pos-trg-tab-trigger="xaut" aria-controls="rollingPosTrgPanelXaut" aria-selected="false" tabindex="-1">XAUTUSD</button>
                    </div>
                </div>
                <div class="rolling-pos-trg-panels">
                    <div class="rolling-pos-trg-panel is-active" id="rollingPosTrgPanelBtc" data-pos-trg-tab-panel="btc" role="tabpanel" aria-label="BTCUSD position triggers">
                        <div class="rolling-pos-trg-panel-head">
                            <span>BTCUSD</span>
                            <span class="rolling-pos-trg-ticker" id="rollingPosTrgBtcTicker">
                                <span class="rolling-pos-trg-ticker-label">Mark</span>
                                <strong data-pos-trg-ticker-price>--</strong>
                                <span class="rolling-pos-trg-ticker-vs" data-pos-trg-ticker-vs></span>
                            </span>
                        </div>
                        <div class="rolling-demo-grid rolling-pos-trg-fields">
                            <div class="rolling-demo-field">
                                <label for="txtRollingFuturesStartQty">Multiplier</label>
                                <% if (!bIsCoveredLivePage) { %>
                                <button class="rolling-futures-start-qty-calc-btn" type="button" id="btnRollingFuturesCalcStartQty" title="Calculate Multiplier from Available Balance" aria-label="Calculate Multiplier from Available Balance">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <rect x="4" y="3" width="16" height="18" rx="2" />
                                        <path d="M8 7h8" />
                                        <path d="M8 12h2" />
                                        <path d="M14 12h2" />
                                        <path d="M8 16h2" />
                                        <path d="M14 16h2" />
                                    </svg>
                                </button>
                                <% } %>
                                <input class="rolling-futures-start-qty" type="number" min="<%= (bIsDemoPage || bIsStrangleLikePage || bIsCoveredLivePage) ? '1' : '2' %>" max="1000" step="1" id="txtRollingFuturesStartQty" value="<%= (bIsDemoPage || bIsStrangleLikePage || bIsCoveredLivePage) ? '1' : '2' %>" />
                            </div>
                            <div class="rolling-demo-field">
                                <label for="txtPosTrgBtcTolerance">Tolerance</label>
                                <input type="number" id="txtPosTrgBtcTolerance" name="txtPosTrgBtcTolerance" min="1" step="1" value="20" title="Auto-watch fires when current price is within this many points of the Strike Price." placeholder="e.g. 20" />
                            </div>
                            <div class="rolling-demo-field">
                                <label for="txtPosTrgBtcBuyStrike">Strike Price</label>
                                <input type="number" id="txtPosTrgBtcBuyStrike" name="txtPosTrgBtcBuyStrike" step="any" inputmode="decimal" placeholder="e.g. 95000" />

                            </div>
                            <div class="rolling-demo-field">
                                <label for="txtPosTrgBtcSlPoints">SL Points</label>
                                <input type="number" id="txtPosTrgBtcSlPoints" name="txtPosTrgBtcSlPoints" step="any" inputmode="decimal" value="300" placeholder="e.g. 300" />
                            </div>
                            <div class="rolling-demo-field">
                                <label for="txtPosTrgBtcTpPoints">TP Points</label>
                                <input type="number" id="txtPosTrgBtcTpPoints" name="txtPosTrgBtcTpPoints" step="any" inputmode="decimal" value="400" placeholder="e.g. 400" />
                            </div>
                            <div class="rolling-demo-field rolling-pos-trg-execute-cell">
                                <label>Action</label>
                                <div style="display:flex; gap:8px;">
                                    <button id="btnPosTrgBtcBuy" class="rolling-demo-btn buy" type="button" style="flex:1; min-height:44px;" title="Place a BUY maker-only limit order at the Strike Price with attached SL/TP points. Places on Delta when maker-valid; otherwise queues locally and auto-places when the mark crosses Strike Price by Tolerance." aria-label="Place a BUY maker-only limit order at the Strike Price">Buy</button>
                                    <button id="btnPosTrgBtcSell" class="rolling-demo-btn sell" type="button" style="flex:1; min-height:44px;" title="Place a SELL maker-only limit order at the Strike Price with attached SL/TP points. Places on Delta when maker-valid; otherwise queues locally and auto-places when the mark crosses Strike Price by Tolerance." aria-label="Place a SELL maker-only limit order at the Strike Price">Sell</button>
                                </div>
                            </div>
                        </div>
                        <div id="rollingPosTrgBtcStatus" class="rolling-pos-trg-status" aria-live="polite"></div>
                    <div class="rolling-pos-trg-pending-section" id="rollingPosTrgBtcPendingSection">
                        <div class="rolling-pos-trg-pending-head">
                            <span>Open &amp; Queued Limit Orders</span>
                            <span class="rolling-pos-trg-watcher-badge" id="rollingPosTrgWatcherBadge" title="Server-side watcher status">Server: checking...</span>
                            <span class="rolling-pos-trg-pending-hint">Pending = queued locally (auto-fires when mark crosses strike by Tolerance). Delta = live on the exchange. Click × to cancel a row.</span>
                        </div>
                        <div class="rolling-pos-trg-pending-empty" id="rollingPosTrgBtcPendingEmpty">No open or queued orders. Use <strong>Buy / Sell</strong> above to place or queue one.</div>
                        <table class="rolling-pos-trg-pending-table" id="rollingPosTrgBtcPendingTable" hidden>
                            <thead>
                                <tr>
                                    <th>Side</th>
                                    <th>Qty</th>
                                    <th>Strike</th>
                                    <th>SL/TP</th>
                                    <th>Tol</th>
                                    <th>Distance</th>
                                    <th>Source</th>
                                    <th class="rolling-pos-trg-pending-cancel-col" aria-label="Cancel"></th>
                                </tr>
                            </thead>
                            <tbody id="rollingPosTrgBtcPendingBody"></tbody>
                        </table>
                    </div>
                    </div>
                    <div class="rolling-pos-trg-panel" id="rollingPosTrgPanelEth" data-pos-trg-tab-panel="eth" role="tabpanel" aria-label="ETHUSD position triggers" hidden>
                        <div class="rolling-pos-trg-panel-head">
                            <span>ETHUSD</span>
                            <span class="rolling-pos-trg-ticker" id="rollingPosTrgEthTicker">
                                <span class="rolling-pos-trg-ticker-label">Mark</span>
                                <strong data-pos-trg-ticker-price>--</strong>
                                <span class="rolling-pos-trg-ticker-vs" data-pos-trg-ticker-vs></span>
                            </span>
                        </div>
                        <div class="rolling-demo-grid rolling-pos-trg-fields">
                            <div class="rolling-demo-field">
                                <label>Multiplier</label>
                                <input class="rolling-futures-start-qty" type="number" min="1" max="1000" step="1" value="1" data-pos-trg-multiplier readonly disabled title="Multiplier is shared with the BTCUSD tab." aria-label="Multiplier (shared with BTCUSD tab)" />
                            </div>
                            <div class="rolling-demo-field">
                                <label for="txtPosTrgEthTolerance">Tolerance</label>
                                <input type="number" id="txtPosTrgEthTolerance" min="1" step="1" value="20" title="Auto-watch fires when current price is within this many points of the Strike Price." placeholder="e.g. 20" />
                            </div>
                            <div class="rolling-demo-field">
                                <label for="txtPosTrgEthBuyStrike">Strike Price</label>
                                <input type="number" id="txtPosTrgEthBuyStrike" step="any" inputmode="decimal" placeholder="e.g. 3500" />
                            </div>
                            <div class="rolling-demo-field">
                                <label for="txtPosTrgEthSlPoints">SL Points</label>
                                <input type="number" id="txtPosTrgEthSlPoints" step="any" inputmode="decimal" value="300" placeholder="e.g. 300" />
                            </div>
                            <div class="rolling-demo-field">
                                <label for="txtPosTrgEthTpPoints">TP Points</label>
                                <input type="number" id="txtPosTrgEthTpPoints" step="any" inputmode="decimal" value="400" placeholder="e.g. 400" />
                            </div>
                            <div class="rolling-demo-field rolling-pos-trg-execute-cell">
                                <label>Action</label>
                                <div style="display:flex; gap:8px;">
                                    <button id="btnPosTrgEthBuy" class="rolling-demo-btn buy" type="button" style="flex:1; min-height:44px;" title="Place a BUY maker-only limit order at the Strike Price with attached SL/TP points.">Buy</button>
                                    <button id="btnPosTrgEthSell" class="rolling-demo-btn sell" type="button" style="flex:1; min-height:44px;" title="Place a SELL maker-only limit order at the Strike Price with attached SL/TP points.">Sell</button>
                                </div>
                            </div>
                        </div>
                        <div id="rollingPosTrgEthStatus" class="rolling-pos-trg-status" aria-live="polite"></div>
                        <div class="rolling-pos-trg-pending-section" id="rollingPosTrgEthPendingSection">
                            <div class="rolling-pos-trg-pending-head">
                                <span>Open &amp; Queued Limit Orders</span>
                                <span class="rolling-pos-trg-watcher-badge" id="rollingPosTrgEthWatcherBadge" title="Server-side watcher status">Server: checking...</span>
                                <span class="rolling-pos-trg-pending-hint">Pending = queued locally. Delta = live on the exchange. Click × to cancel a row.</span>
                            </div>
                            <div class="rolling-pos-trg-pending-empty" id="rollingPosTrgEthPendingEmpty">No open or queued orders. Use <strong>Buy / Sell</strong> above to place or queue one.</div>
                            <table class="rolling-pos-trg-pending-table" id="rollingPosTrgEthPendingTable" hidden>
                                <thead><tr><th>Side</th><th>Qty</th><th>Strike</th><th>SL/TP</th><th>Tol</th><th>Distance</th><th>Source</th><th class="rolling-pos-trg-pending-cancel-col" aria-label="Cancel"></th></tr></thead>
                                <tbody id="rollingPosTrgEthPendingBody"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="rolling-pos-trg-panel" id="rollingPosTrgPanelXaut" data-pos-trg-tab-panel="xaut" role="tabpanel" aria-label="XAUTUSD position triggers" hidden>
                        <div class="rolling-pos-trg-panel-head">
                            <span>XAUTUSD</span>
                            <span class="rolling-pos-trg-ticker" id="rollingPosTrgXautTicker">
                                <span class="rolling-pos-trg-ticker-label">Mark</span>
                                <strong data-pos-trg-ticker-price>--</strong>
                                <span class="rolling-pos-trg-ticker-vs" data-pos-trg-ticker-vs></span>
                            </span>
                        </div>
                        <div class="rolling-demo-grid rolling-pos-trg-fields">
                            <div class="rolling-demo-field">
                                <label>Multiplier</label>
                                <input class="rolling-futures-start-qty" type="number" min="1" max="1000" step="1" value="1" data-pos-trg-multiplier readonly disabled title="Multiplier is shared with the BTCUSD tab." aria-label="Multiplier (shared with BTCUSD tab)" />
                            </div>
                            <div class="rolling-demo-field">
                                <label for="txtPosTrgXautTolerance">Tolerance</label>
                                <input type="number" id="txtPosTrgXautTolerance" min="1" step="1" value="20" title="Auto-watch fires when current price is within this many points of the Strike Price." placeholder="e.g. 5" />
                            </div>
                            <div class="rolling-demo-field">
                                <label for="txtPosTrgXautBuyStrike">Strike Price</label>
                                <input type="number" id="txtPosTrgXautBuyStrike" step="any" inputmode="decimal" placeholder="e.g. 2900" />
                            </div>
                            <div class="rolling-demo-field">
                                <label for="txtPosTrgXautSlPoints">SL Points</label>
                                <input type="number" id="txtPosTrgXautSlPoints" step="any" inputmode="decimal" value="300" placeholder="e.g. 30" />
                            </div>
                            <div class="rolling-demo-field">
                                <label for="txtPosTrgXautTpPoints">TP Points</label>
                                <input type="number" id="txtPosTrgXautTpPoints" step="any" inputmode="decimal" value="400" placeholder="e.g. 40" />
                            </div>
                            <div class="rolling-demo-field rolling-pos-trg-execute-cell">
                                <label>Action</label>
                                <div style="display:flex; gap:8px;">
                                    <button id="btnPosTrgXautBuy" class="rolling-demo-btn buy" type="button" style="flex:1; min-height:44px;" title="Place a BUY maker-only limit order at the Strike Price with attached SL/TP points.">Buy</button>
                                    <button id="btnPosTrgXautSell" class="rolling-demo-btn sell" type="button" style="flex:1; min-height:44px;" title="Place a SELL maker-only limit order at the Strike Price with attached SL/TP points.">Sell</button>
                                </div>
                            </div>
                        </div>
                        <div id="rollingPosTrgXautStatus" class="rolling-pos-trg-status" aria-live="polite"></div>
                        <div class="rolling-pos-trg-pending-section" id="rollingPosTrgXautPendingSection">
                            <div class="rolling-pos-trg-pending-head">
                                <span>Open &amp; Queued Limit Orders</span>
                                <span class="rolling-pos-trg-watcher-badge" id="rollingPosTrgXautWatcherBadge" title="Server-side watcher status">Server: checking...</span>
                                <span class="rolling-pos-trg-pending-hint">Pending = queued locally. Delta = live on the exchange. Click × to cancel a row.</span>
                            </div>
                            <div class="rolling-pos-trg-pending-empty" id="rollingPosTrgXautPendingEmpty">No open or queued orders. Use <strong>Buy / Sell</strong> above to place or queue one.</div>
                            <table class="rolling-pos-trg-pending-table" id="rollingPosTrgXautPendingTable" hidden>
                                <thead><tr><th>Side</th><th>Qty</th><th>Strike</th><th>SL/TP</th><th>Tol</th><th>Distance</th><th>Source</th><th class="rolling-pos-trg-pending-cancel-col" aria-label="Cancel"></th></tr></thead>
                                <tbody id="rollingPosTrgXautPendingBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="rolling-demo-section rolling-futures-card-stack">
            <div class="app-panel rolling-demo-card">
                <div class="rolling-demo-card-head rolling-live-open-head">
                    <div class="rolling-live-open-title-group">
                        <h2>Open Positions</h2>
                        <% if (bIsPaperDemoPage || bIsCoveredLivePage) { %>
                            <input type="number" min="1" step="1" value="120" id="txtRollingDualFuturesProfitCloseTimerSecs" class="rolling-live-open-timer-input" title="Close timer in seconds" aria-label="Close timer in seconds" />
                        <% } %>
                    </div>
                    <div class="rolling-covered-hedge-summary" id="rollingDualFuturesHedgeGateSummary" aria-live="polite">
                        <span class="rolling-covered-hedge-chip off">Gate Off</span>
                    </div>
                    <div class="rolling-live-open-signal rolling-live-profit-close-timer" id="rollingDualFuturesProfitCloseTimer" hidden></div>
                    <div class="rolling-demo-card-tools">
                        <% if (bIsCoveredLivePage) { %>
                            <label class="rolling-futures-neutral-mode rolling-live-auto-trader-off" for="chkRollingFuturesAutoTraderOffOnProfitClose" title="Stop Auto Trader when Exit All profit rules close all positions">
                                <input type="checkbox" id="chkRollingFuturesAutoTraderOffOnProfitClose" />
                                <span>Auto Trader-Off</span>
                            </label>
                        <% } %>
